1091.91492317836" gYpos="5194.82209364759" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="178.582677165354" YPOS="5988.20209973753" OwnPage="17" ItemID="883336080" PTYPE="4" WIDTH="170.078606299213" HEIGHT="116.832395950505" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 116.832 L0 116.832 L0 0 Z" copath="M0 0 L170.079 0 L170.079 116.832 L0 116.832 L0 0 Z" gXpos="178.582677165354" gYpos="5988.20209973753" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="883256784" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CH="a, suno o! mi jan en sina sewi"/>
                <breakline/>
                <ITEXT CH="li wile awen weka sin tan seme?"/>
                <breakline/>
                <ITEXT CH="mi o ken awen jo e pana seli"/>
                <breakline/>
                <ITEXT CH="tan tenpo sina ni lon lape lete…"/>
                <para/>
                <ITEXT CH="o weka ala! pakala! mi lukin"/>
                <breakline/>
                <ITEXT CH="e loje kon e kule jaki mun!"/>
                <breakline/>
                <ITEXT CH="o lukin insa tawa lukin tu mi:"/>
                <breakline/>
                <ITEXT CH="sike tu wan o awen e mi tu."/>
                <para/>
                <ITEXT CH="mi awen lukin ni la suno jelo"/>
                <breakline/>
                <ITEXT CH="li kama seme? lukin mi la selo"/>
                <breakline/>
                <ITEXT CH="li kule seme sin e sike a?"/>
                <para/>
                <ITEXT CH="a! sina jelo ala jelo taso,"/>
                <breakline/>
                <ITEXT CH="li walo anu loje anu laso?"/>
                <breakline/>
                <ITEXT CH="mi wile son–… a! sina pimeja."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="352.787335474512" YPOS="5941.35583052119" OwnPage="17" ItemID="883341744" PTYPE="4" WIDTH="170.078543307087" HEIGHT="17.1308586426685" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Copy of lawa_1 (7)" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 17.1309 L0 17.1309 L0 0 Z" copath="M0 0 L170.079 0 L170.079 17.1309 L0 17.1309 L0 0 Z" gXpos="83.1900843496528" gYpos="352.716910386202" gWidth="170.078543307087" gHeight="76.535433070866" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
