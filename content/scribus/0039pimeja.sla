                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="toki musi ni li"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="tan toki Aja. jan Owane Tumunjan li"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="pali e"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="ona lon tenpo sike nanpa LLLTTALTW. jan mute li"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="sona e"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="toki ni tan sitelen musi. kulupu pali Amenpin li"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="sitelen e"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="toki ni  kepeken toki Lusi lon tenpo sike LLLTTAMMMMTW. sitelen ona li"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="pona nasa tawa jan mute. sina ken alasa e"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="sitelen lon lipu Jutu. taso mi wile toki pona e"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="toki pi jan Tumunjan. kin la mi ante lili e"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="toki. toki pona la musi ni li"/>
                <nbspace CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text489_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="pona."/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="jo ala e"/>
                <nbspace/>
                <ITEXT CH="mani. ona li"/>
                <nbspace/>
                <ITEXT CH="kama pali lon kulupu. kulupu li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="kala. tenpo wan la ona li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="kala pona"/>
                <nbspace/>
                <ITEXT CH="a! jan majuna li"/>
                <nbspace/>
                <ITEXT CH="luka e"/>
                <nbspace/>
                <ITEXT CH="kala li"/>
                <nbspace/>
                <ITEXT CH="pilin: “a. sama jan la kala kin li"/>
                <nbspace/>
                <ITEXT CH="ken pilin. pilin pona la, pilin ike la, kulupu mama la, kulupu poka la, ni ale li"/>
                <nbspace/>
                <ITEXT CH="ken lon kala.”"/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="pilin ike tawa kala. kala li"/>
                <nbspace/>
                <ITEXT CH="toki tawa ona: “o"/>
                <nbspace/>
                <ITEXT CH="kute! mi musi pona lon telo. jan alasa li"/>
                <nbspace/>
                <ITEXT CH="jo ike e"/>
                <nbspace/>
                <ITEXT CH="mi. mi weka la kulupu mama mi en kulupu poka mi li"/>
                <nbspace/>
                <ITEXT CH="pilin ike. mi lon ala telo la mi kama moli. mi wile lon telo. mi wile musi lon ona. o"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="pilin mi. o"/>
                <nbspace/>
                <ITEXT CH="weka e"/>
                <nbspace/>
                <ITEXT CH="mi tawa telo.” kala li"/>
                <nbspace/>
                <ITEXT CH="toki pi wawa ala. wawa kala li"/>
                <nbspace/>
                <ITEXT CH="kama lili tan telo ala."/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="pilin kala li"/>
                <nbspace/>
                <ITEXT CH="weka e"/>
                <nbspace/>
                <ITEXT CH="ona tawa telo. “o"/>
                <nbspace/>
                <ITEXT CH="tawa, kala pona"/>
                <nbspace/>
                <ITEXT CH="o. kulupu sina o"/>
                <nbspace/>
                <ITEXT CH="pilin pona.”"/>
                <para/>
                <ITEXT CH="kulupu pali li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ni. “sina nasa, jan majuna"/>
                <nbspace/>
                <ITEXT CH="o! sina pakala e"/>
                <nbspace/>
                <ITEXT CH="pali mi. o"/>
                <nbspace/>
                <ITEXT CH="weka! weka moku o"/>
                <nbspace/>
                <ITEXT CH="moli e"/>
                <nbspace/>
                <ITEXT CH="sina!”"/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="weka. moku ala li"/>
                <nbspace/>
                <ITEXT CH="lon. ona o"/>
                <nbspace/>
                <ITEXT CH="seme? ona li"/>
                <nbspace/>
                <ITEXT CH="sona ala."/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="tawa tomo la monsuta li"/>
                <nbspace/>
                <ITEXT CH="kama lon poka. monsuta li"/>
                <nbspace/>
                <ITEXT CH="toki tawa ona: “toki, jan majuna"/>
                <nbspace/>
                <ITEXT CH="o! sina pilin ike tan seme?"/>
                <nbspace/>
                <ITEXT CH="a, sina jo ala e"/>
                <nbspace/>
                <ITEXT CH="moku e"/>
                <nbspace/>
                <ITEXT CH="pali anu seme? o"/>
                <nbspace/>
                <ITEXT CH="kute. mi pana e"/>
                <nbspace/>
                <ITEXT CH="soweli pona tawa sina. soweli li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="telo wawa. o"/>
                <nbspace/>
                <ITEXT CH="moku pona e"/>
                <nbspace/>
                <ITEXT CH="ona. o"/>
                <nbspace/>
                <ITEXT CH="kepeken soweli mi lon tenpo sike tu wan. taso tenpo li"/>
                <nbspace/>
                <ITEXT CH="pini la mi kama li"/>
                <nbspace/>
                <ITEXT CH="wile sona e"/>
                <nbspace/>
                <ITEXT CH="ijo. sina o"/>
                <nbspace/>
                <ITEXT CH="alasa pana e"/>
                <nbspace/>
                <ITEXT CH="sona. sina ken la soweli li"/>
                <nbspace/>
                <ITEXT CH="awen soweli sina. ken ala la mi kama jo e"/>
                <nbspace/>
                <ITEXT CH="soweli e"/>
                <nbspace/>
                <ITEXT CH="sina kin. pona ala pona?”"/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="pilin e"/>
                <nbspace/>
                <ITEXT CH="ni: “a, esun ni li"/>
                <nbspace/>
                <ITEXT CH="ike. taso mi esun ala la mi moku ala li"/>
                <nbspace/>
                <ITEXT CH="moli. tenpo sike tu wan la soweli o"/>
                <nbspace/>
                <ITEXT CH="pana pona e"/>
                <nbspace/>
                <ITEXT CH="moku. tenpo li"/>
                <nbspace/>
                <ITEXT CH="pini la mi anpa.” jan majuna en monsuta li"/>
                <nbspace/>
                <ITEXT CH="esun."/>
                <para/>
                <ITEXT CH="tenpo sike tu wan li"/>
                <nbspace/>
                <ITEXT CH="pini. jan majuna li"/>
                <nbspace/>
                <ITEXT CH="moku pona e"/>
                <nbspace/>
                <ITEXT CH="telo soweli li"/>
                <nbspace/>
                <ITEXT CH="moli ala. taso pimeja la monsuta li"/>
                <nbspace/>
                <ITEXT CH="kama. jan majuna li"/>
                <nbspace/>
                <ITEXT CH="pilin ike: “seme li"/>
                <nbspace/>
                <ITEXT CH="ken awen e"/>
                <nbspace/>
                <ITEXT CH="mi tan monsuta?“"/>
                <para/>
                <ITEXT CH="mije pona li"/>
                <nbspace/>
                <ITEXT CH="kama lon tomo. jan majuna li"/>
                <nbspace/>
                <ITEXT CH="sona ala e"/>
                <nbspace/>
                <ITEXT CH="ona. mije li"/>
                <nbspace/>
                <ITEXT CH="open: “toki! mi ken ala ken awen lon tomo sina lon pimeja ni? suno li"/>
                <nbspace/>
                <ITEXT CH="kama la mi tawa.”"/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="toki: “ken. taso o"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="ni: ike la mi en monsuta li"/>
                <nbspace/>
                <ITEXT CH="esun. monsuta li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="soweli. soweli ni la mi moku e"/>
                <nbspace/>
                <ITEXT CH="telo li"/>
                <nbspace/>
                <ITEXT CH="moli ala. taso monsuta o"/>
                <nbspace/>
                <ITEXT CH="kama lon pimeja ni o"/>
                <nbspace/>
                <ITEXT CH="toki. ona li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="sona mi. mi ken pana pona e"/>
                <nbspace/>
                <ITEXT CH="sona la soweli li"/>
                <nbspace/>
                <ITEXT CH="awen lon poka mi. mi ken ala la monsuta li"/>
                <nbspace/>
                <ITEXT CH="kama jo e"/>
                <nbspace/>
                <ITEXT CH="mi. mi sona ala e"/>
                <nbspace/>
                <ITEXT CH="nasin pona pi toki sona. ken suli la monsuta li"/>
                <nbspace/>
                <ITEXT CH="anpa e"/>
                <nbspace/>
                <ITEXT CH="mi. wile mi la ona o"/>
                <nbspace/>
                <ITEXT CH="anpa ala e"/>
                <nbspace/>
                <ITEXT CH="sina kin!”"/>
                <para/>
                <ITEXT CH="mije la: “ale o"/>
                <nbspace/>
                <ITEXT CH="pona, jan majuna"/>
                <nbspace/>
                <ITEXT CH="o.” mije li"/>
                <nbspace/>
                <ITEXT CH="awen lon tomo."/>
                <para/>
                <ITEXT CH="pimeja li"/>
                <nbspace/>
                <ITEXT CH="kama. jan majuna li"/>
                <nbspace/>
                <ITEXT CH="kute e"/>
                <nbspace/>
                <ITEXT CH="kalama suli. ijo li"/>
                <nbspace/>
                <ITEXT CH="luka wawa e"/>
                <nbspace/>
                <ITEXT CH="lupa tomo."/>
                <para/>
                <ITEXT CH="jan majuna la: “jan seme li"/>
                <nbspace/>
                <ITEXT CH="lon?”"/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="kute e"/>
                <nbspace/>
                <ITEXT CH="ni: “mi jan ala. mi monsuta! mi kama. o"/>
                <nbspace/>
                <ITEXT CH="kute e"/>
                <nbspace/>
                <ITEXT CH="wile sona mi. o"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="sona!”"/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="pilin monsuta li"/>
                <nbspace/>
                <ITEXT CH="ken ala toki. pakala! mije li"/>
                <nbspace/>
                <ITEXT CH="toki: “o"/>
                <nbspace/>
                <ITEXT CH="pilin monsuta ala. mi o"/>
                <nbspace/>
                <ITEXT CH="toki tawa ona.”"/>
                <para/>
                <ITEXT CH="monsuta la: "/>
                <ITEXT CPARENT="Text489_Italic" CH="“mi lon"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="a!”"/>
                <breakline/>
                <ITEXT CH="mije la: “mi kin li"/>
                <nbspace/>
                <ITEXT CH="lon.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“a? sina kama tan seme?”"/>
                <breakline/>
                <ITEXT CH="“mi kama tan weka telo.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“sina kama lon poka telo kepeken seme?”"/>
                <breakline/>
                <ITEXT CH="“kepeken pipi lili.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“pipi li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="lili la ma telo kin li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="lili anu seme?”"/>
                <breakline/>
                <ITEXT CH="“lili ala. waso wawa li"/>
                <nbspace/>
                <ITEXT CH="alasa tawa lon sewi telo la ona li"/>
                <nbspace/>
                <ITEXT CH="ken ala.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“a, waso li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="lon sike mama taso anu seme?”"/>
                <breakline/>
                <ITEXT CH="“lon sike ala. luka pi waso ni li"/>
                <nbspace/>
                <ITEXT CH="suli, li"/>
                <nbspace/>
                <ITEXT CH="ken len pimeja e"/>
                <nbspace/>
                <ITEXT CH="ma tomo.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“ma la tomo pi mute ala li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="lon anu seme?”"/>
                <breakline/>
                <ITEXT CH="“mute"/>
                <nbspace/>
                <ITEXT CH="a. soweli wawa li"/>
                <nbspace/>
                <ITEXT CH="alasa tawa tomo ale la ona li"/>
                <nbspace/>
                <ITEXT CH="ken ala.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“soweli li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="lili ike anu seme?”"/>
                <breakline/>
                <ITEXT CH="“ike ala. selo soweli li"/>
                <nbspace/>
                <ITEXT CH="ken len pona luka.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“len li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="pona tawa seme?”"/>
                <breakline/>
                <ITEXT CH="“soweli li"/>
                <nbspace/>
                <ITEXT CH="tawa mute li"/>
                <nbspace/>
                <ITEXT CH="wile lape la len li"/>
                <nbspace/>
                <ITEXT CH="pona.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“seme li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="pana e"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="len tawa soweli?”"/>
                <breakline/>
                <ITEXT CH="“waso li"/>
                <nbspace/>
                <ITEXT CH="tawa lon sewi tomo la luka ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="len pimeja tawa soweli.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“a, waso li"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="tawa lon sike anu seme?”"/>
                <breakline/>
                <ITEXT CH="“waso li"/>
                <nbspace/>
                <ITEXT CH="kama tan sike li"/>
                <nbspace/>
                <ITEXT CH="tawa lon sike li"/>
                <nbspace/>
                <ITEXT CH="ken awen lon sike luka.”"/>
                <breakline/>
                <ITEXT CPARENT="Text489_Italic" CH="“aaa! sina toki e"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="len seme, e"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="sike seme, e"/>
                <nbspace CPARENT="Text489_Italic"/>
                <ITEXT CPARENT="Text489_Italic" CH="luka seme! mi ken ala sona!”"/>
                <para/>
                <ITEXT CH="monsuta li"/>
                <nbspace/>
                <ITEXT CH="pilin e"/>
                <nbspace/>
                <ITEXT CH="sona wawa mije. monsuta li"/>
                <nbspace/>
                <ITEXT CH="anpa li"/>
                <nbspace/>
                <ITEXT CH="tawa weka."/>
                <para/>
                <ITEXT CH="jan majuna li"/>
                <nbspace/>
                <ITEXT CH="pilin pona. “mije"/>
                <nbspace/>
                <ITEXT CH="o! sina awen e"/>
                <nbspace/>
                <ITEXT CH="mi tan monsuta. seme la mi ken pana e"/>
                <nbspace/>
                <ITEXT CH="pona tawa sina?”"/>
                <para/>
                <ITEXT CH="mije la: “lon la sina pana e"/>
                <nbspace/>
                <ITEXT CH="pona tawa mi. sina pana e"/>
                <nbspace/>
                <ITEXT CH="mi tawa telo, tawa kulupu mi. pona sina li"/>
                <nbspace/>
                <ITEXT CH="kama sin lon sina. mi kala. mi tawa.” ni li"/>
                <nbspace/>
                <ITEXT CH="nasa pona e"/>
                <nbspace/>
                <ITEXT CH="pilin pi jan majuna."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
