        <PAGEOBJECT XPOS="178.582645669292" YPOS="2123.55905511811" OwnPage="5" ItemID="242817568" PTYPE="4" WIDTH="170.078606299213" HEIGHT="227.428571428571" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 227.429 L0 227.429 L0 0 Z" copath="M0 0 L170.079 0 L170.079 227.429 L0 227.429 L0 0 Z" gXpos="178.582645669292" gYpos="2123.55905511811" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="242837392" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CH="tenpo pimeja nasa"/>
                <para PARENT="jan pali"/>
                <ITEXT CPARENT="Text424_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="tenpo pimeja li"/>
                <nbspace CPARENT="Text424_Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text424_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="tan seme?"/>
                <ITEXT CH=" sina sona: suno li"/>
                <nbspace/>
                <ITEXT CH="kama lon anpa ma. lon la, ma a li"/>
                <nbspace/>
                <ITEXT CH="tawa li"/>
                <nbspace/>
                <ITEXT CH="kama len e"/>
                <nbspace/>
                <ITEXT CH="suno. tenpo pimeja ale la, ma li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="suno. anu seme? tenpo poka la, mi lukin e"/>
                <nbspace/>
                <ITEXT CH="tenpo pimeja nasa: "/>
                <ITEXT CPARENT="Text424_Italic" CH="mun"/>
                <ITEXT CH=" li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="suno."/>
                <para/>
                <ITEXT CH="mi lukin e"/>
                <nbspace/>
                <ITEXT CH="ni lon kulupu jan pi toki pona. suno li"/>
                <nbspace/>
                <ITEXT CH="lon sewi la, mun li"/>
                <nbspace/>
                <ITEXT CH="kama lon sinpin ona kepeken tenpo suli, li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="ale ona lon tenpo lili taso. tenpo lili ni la sewi li"/>
                <nbspace/>
                <ITEXT CH="kama pimeja; la mi kama ken lukin e"/>
                <nbspace/>
                <ITEXT CH="mun lili lon poka ale sewi. kin la mi ken lukin e"/>
                <nbspace/>
                <ITEXT CH="sike suno nasa: ni li"/>
                <nbspace/>
                <ITEXT CH="selo suno; sina ken ala lukin e"/>
                <nbspace/>
                <ITEXT CH="ona lon tenpo ale tan ni: insa suno li"/>
                <nbspace/>
                <ITEXT CH="wawa a tawa selo."/>
                <para/>
                <ITEXT CH="poka ma mi"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="mun li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="suno la, jan li"/>
                <nbspace/>
                <ITEXT CH="ken ala ken lukin e"/>
                <nbspace/>
                <ITEXT CH="ni lon ma ale? ken ala. mun li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="pimeja tawa ma lili taso. sina wile lukin e"/>
                <nbspace/>
                <ITEXT CH="len pi ale a suno la, ma lili a li"/>
                <nbspace/>
                <ITEXT CH="pona tawa ni."/>
                <para/>
                <ITEXT CH="tenpo pini la, mi kama sona e"/>
                <nbspace/>
                <ITEXT CH="ni: tenpo ala pi lon mi la mun li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="suno ale tawa ma mi. ni li"/>
                <nbspace/>
                <ITEXT CH="tan seme? lon la, tan pona li"/>
                <nbspace/>
                <ITEXT CH="lon ala. mun li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="suno tawa ma mi lon tenpo pini lon tenpo kama. len suno la mun li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="pimeja lili taso; kin la ma mi li"/>
                <nbspace/>
                <ITEXT CH="lili. pimeja lili en ma mi lili li"/>
                <nbspace/>
                <ITEXT CH="lon ala ma sama lon tenpo sama la ni li"/>
                <nbspace/>
                <ITEXT CH="nasa ala. taso, mi ken toki e"/>
                <nbspace/>
                <ITEXT CH="ni: lon la, len suno ni li"/>
                <nbspace/>
                <ITEXT CH="mute lili lon "/>
                <ITEXT CPARENT="Text424_Italic" CH="poka ma"/>
                <ITEXT CH=" mi."/>
                <para/>
                <ITEXT CH="poka ma mi li"/>
                <nbspace/>
                <ITEXT CH="seme? o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ma ale. sina ken sitelen e"/>
                <nbspace/>
                <ITEXT CH="linja suli wan lon insa: ona li"/>
                <nbspace/>
                <ITEXT CH="sike pi seli nanpa wan. o"/>
                <nbspace/>
                <ITEXT CH="tu e"/>
                <nbspace/>
                <ITEXT CH="ma ale lon linja ni. sina kama jo e"/>
                <nbspace/>
                <ITEXT CH="poka tu ma. poka wan la, jan en ma li"/>
                <nbspace/>
                <ITEXT CH="mute, telo li"/>
                <nbspace/>
                <ITEXT CH="lili tawa poka ante. poka ante la, jan en ma li"/>
                <nbspace/>
                <ITEXT CH="lili, telo li"/>
                <nbspace/>
                <ITEXT CH="suli. mi tan poka pi jan lili."/>
                <para/>
                <ITEXT CH="len suno li"/>
                <nbspace/>
                <ITEXT CH="mute ante lon poka ante"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="ma li"/>
                <nbspace/>
                <ITEXT CH="sike e"/>
                <nbspace/>
                <ITEXT CH="suno la, ona li"/>
                <nbspace/>
                <ITEXT CH="weka seme tan suno? mute a. taso, weka ni li"/>
                <nbspace/>
                <ITEXT CH="sama ala lon tenpo ale. sike wan la, weka li"/>
                <nbspace/>
                <ITEXT CH="suli nanpa wan lon tenpo wan, li"/>
                <nbspace/>
                <ITEXT CH="lili nanpa wan lon tenpo wan ante. weka li"/>
                <nbspace/>
                <ITEXT CH="suli la ma li"/>
                <nbspace/>
                <ITEXT CH="lete; weka li"/>
                <nbspace/>
                <ITEXT CH="lili la ma li"/>
                <nbspace/>
                <ITEXT CH="seli – anu seme? ala a! tenpo lete en tenpo seli li"/>
                <nbspace/>
                <ITEXT CH="tan ijo ante. ken la sina sona e"/>
                <nbspace/>
                <ITEXT CH="ni: poka ante ma li"/>
                <nbspace/>
                <ITEXT CH="lete lon tenpo ante li"/>
                <nbspace/>
                <ITEXT CH="seli lon tenpo ante."/>
                <para/>
                <ITEXT CH="poka ma mi la, tenpo seli li"/>
                <nbspace/>
                <ITEXT CH="tenpo ni: ma li"/>
                <nbspace/>
                <ITEXT CH="poka nanpa wan tawa suno. poka ante la, tenpo seli li"/>
                <nbspace/>
                <ITEXT CH="tenpo ni: ma li"/>
                <nbspace/>
                <ITEXT CH="weka nanpa wan tawa suno. sina tan poka ni la sona ni li"/>
                <nbspace/>
                <ITEXT CH="ken nasa, taso ona li"/>
                <nbspace/>
                <ITEXT CH="lon."/>
                <para/>
                <ITEXT CH="sina wile lukin e"/>
                <nbspace/>
                <ITEXT CH="len suno la, ijo seme li"/>
                <nbspace/>
                <ITEXT CH="pona? nanpa wan la, sina wile ken lukin e"/>
                <nbspace/>
                <ITEXT CH="suno lon tenpo suli – li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="tenpo suno suli – tan ni: len suno li"/>
                <nbspace/>
                <ITEXT CH="ken lon tenpo ale, la suno o"/>
                <nbspace/>
                <ITEXT CH="lon sewi lon tenpo ni. tenpo seli li"/>
                <nbspace/>
                <ITEXT CH="pona tawa ni; ona la tenpo suno li"/>
                <nbspace/>
                <ITEXT CH="suli."/>
                <para/>
                <ITEXT CH="nanpa tu la, sina wile e"/>
                <nbspace/>
                <ITEXT CH="ni: tawa lukin la, mun li"/>
                <nbspace/>
                <ITEXT CH="suli tawa suno; la ona li"/>
                <nbspace/>
                <ITEXT CH="ken len e"/>
                <nbspace/>
                <ITEXT CH="ale suno. tenpo seme li"/>
                <nbspace/>
                <ITEXT CH="pona tawa ni? tenpo ni: ma li"/>
                <nbspace/>
                <ITEXT CH="weka nanpa wan tawa suno! ma li"/>
                <nbspace/>
                <ITEXT CH="sike e"/>
                <nbspace/>
                <ITEXT CH="suno la, lukin la suno li"/>
                <nbspace/>
                <ITEXT CH="kama suli li"/>
                <nbspace/>
                <ITEXT CH="kama lili (sina ken ala lukin e"/>
                <nbspace/>
                <ITEXT CH="ante ni kepeken ala ilo, ona li"/>
                <nbspace/>
                <ITEXT CH="ante lili). tenpo la suno li"/>
                <nbspace/>
                <ITEXT CH="ken suli tawa mun; la mun li"/>
                <nbspace/>
                <ITEXT CH="ken ala len e"/>
                <nbspace/>
                <ITEXT CH="ale suno."/>
                <para/>
                <ITEXT CH="poka ma pi mi ala la ijo ni tu li"/>
                <nbspace/>
                <ITEXT CH="ken kama lon tenpo sama: tenpo seli li"/>
                <nbspace/>
                <ITEXT CH="tenpo pi weka nanpa wan kin. ma mi la, ante: tenpo seli la suno li"/>
                <nbspace/>
                <ITEXT CH="poka li"/>
                <nbspace/>
                <ITEXT CH="suli ike; tenpo lete la suno li"/>
                <nbspace/>
                <ITEXT CH="lon sewi lon tenpo lili. ni la, poka ni la len suno pona li"/>
                <nbspace/>
                <ITEXT CH="lili tawa poka ante. lon la, ante ni pi mute len li"/>
                <nbspace/>
                <ITEXT CH="lili taso. sina lon poka ma mi la, ken suli la sina awen ken lukin e"/>
                <nbspace/>
                <ITEXT CH="len suno lon tenpo kama (ken la sina o"/>
                <nbspace/>
                <ITEXT CH="tawa lili tawa ma ante)."/>
                <para/>
                <ITEXT CH="tenpo ni la, mi awen ala lon ma mi, li"/>
                <nbspace/>
                <ITEXT CH="awen lon ma Elopa; la, mi ken tawa tenpo kulupu pi toki pona li"/>
                <nbspace/>
                <ITEXT CH="ken lukin e"/>
                <nbspace/>
                <ITEXT CH="tenpo pimeja nasa lon poka pi jan pona a. lon la mun li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="suno lon poka pi ma ale – mi la, kulupu pi toki pona kin o"/>
                <nbspace/>
                <ITEXT CH="lon poka ale ma."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
