                <ITEXT CH="MMMMTT (84). lupa nanpa ni li"/>
                <nbspace/>
                <ITEXT CH="suli li"/>
                <nbspace/>
                <ITEXT CH="luka tu tu! lupa ni li"/>
                <nbspace/>
                <ITEXT CH="lon ala nasin toki pi jan pi toki pona! tenpo ni la lupa ni li"/>
                <nbspace/>
                <ITEXT CH="weka. anpa pi nimi "/>
                <ITEXT CPARENT="Text723_Italic" CH="suli"/>
                <ITEXT CH=" la nimi ni li"/>
                <nbspace/>
                <ITEXT CH="lon: mu (89%), selo (89%), kin (87%), unpa (87%), monsuta (86%). lon a! tenpo ni la nimi “kin” en nimi “monsuta” li"/>
                <nbspace/>
                <ITEXT CH="kama nimi "/>
                <ITEXT CPARENT="Text723_Italic" CH="suli"/>
                <ITEXT CH="."/>
                <para/>
                <ITEXT CH="nasin li"/>
                <nbspace/>
                <ITEXT CH="ante. taso jan li"/>
                <nbspace/>
                <ITEXT CH="ante kin e"/>
                <nbspace/>
                <ITEXT CH="toki ona. nimi “pu” en nimi “ku” en nimi “su” li"/>
                <nbspace/>
                <ITEXT CH="kama lili. ni li"/>
                <nbspace/>
                <ITEXT CH="lon tan seme? nanpa wan la nasin li"/>
                <nbspace/>
                <ITEXT CH="ante. ni la jan li"/>
                <nbspace/>
                <ITEXT CH="ken toki e"/>
                <nbspace/>
                <ITEXT CH="sona ona pi nimi “pu”. taso nimi “ku” en nimi “su” li"/>
                <nbspace/>
                <ITEXT CH="ante kin. ante la jan li"/>
                <nbspace/>
                <ITEXT CH="pilin e"/>
                <nbspace/>
                <ITEXT CH="ni: nimi pi lipu wan li"/>
                <nbspace/>
                <ITEXT CH="nimi tan seme?"/>
                <para/>
                <ITEXT CH="mi la ante ni li"/>
                <nbspace/>
                <ITEXT CH="pona. mi pilin e"/>
                <nbspace/>
                <ITEXT CH="ni: nimi lipu li"/>
                <nbspace/>
                <ITEXT CH="sama nimi jan. ni la mi ken kepeken e"/>
                <nbspace/>
                <ITEXT CH="nasin ni kin: lipu Pu, lipu Ku, lipu Su. toki pona la nimi mute ala li"/>
                <nbspace/>
                <ITEXT CH="lon. nimi lipu li"/>
                <nbspace/>
                <ITEXT CH="suli ala tawa jan mute."/>
                <para/>
                <ITEXT CH="nimi "/>
                <ITEXT CPARENT="Text723_Italic" CH="lili"/>
                <ITEXT CH=" la ante mute li"/>
                <nbspace/>
                <ITEXT CH="lon. nimi ni li"/>
                <nbspace/>
                <ITEXT CH="kama suli: puwa, usawi, mijomi, melome, omekapo, nja, te, to. nimi “ali” taso li"/>
                <nbspace/>
                <ITEXT CH="kama lili. nimi ante la ante ni li"/>
                <nbspace/>
                <ITEXT CH="lon: kijetesantakalu en epiku en oko li"/>
                <nbspace/>
                <ITEXT CH="kama lili. misikeke li"/>
                <nbspace/>
                <ITEXT CH="kama suli. ante ni ale li"/>
                <nbspace/>
                <ITEXT CH="lili a. taso ante suli wan li"/>
                <nbspace/>
                <ITEXT CH="lon:"/>
                <para/>
                <ITEXT CH="kisa¹. kisa li"/>
                <nbspace/>
                <ITEXT CH="kama jo e"/>
                <nbspace/>
                <ITEXT CH="kule. tenpo pini la ona li"/>
                <nbspace/>
                <ITEXT CH="jo ala e"/>
                <nbspace/>
                <ITEXT CH="kule. tenpo ni la ona li"/>
                <nbspace/>
                <ITEXT CH="lon kulupu pi nimi "/>
                <ITEXT CPARENT="Text723_Italic" CH="lili"/>
                <ITEXT CH=". nimi wan taso li"/>
                <nbspace/>
                <ITEXT CH="kama jo e"/>
                <nbspace/>
                <ITEXT CH="kule. mi la ni li"/>
                <nbspace/>
                <ITEXT CH="suli tan ni: nimi sin li"/>
                <nbspace/>
                <ITEXT CH="pona mute tawa mi. nimi “kisa” en nimi “puwa” en nimi “misa” li"/>
                <nbspace/>
                <ITEXT CH="kama suli a. nimi ale ni li"/>
                <nbspace/>
                <ITEXT CH="nimi soweli. mi pilin e"/>
                <nbspace/>
                <ITEXT CH="ni: ijo li"/>
                <nbspace/>
                <ITEXT CH="suli tawa jan la jan li"/>
                <nbspace/>
                <ITEXT CH="wile kepeken e"/>
                <nbspace/>
                <ITEXT CH="nimi tawa ona. mi wile toki e"/>
                <nbspace/>
                <ITEXT CH="kisa mi anu puwa mi la mi o"/>
                <nbspace/>
                <ITEXT CH="kepeken nimi seme? kisa li"/>
                <nbspace/>
                <ITEXT CH="ken soweli ko anu soweli lili anu soweli pi kalama noka ala anu soweli suwi… lawa mi li"/>
                <nbspace/>
                <ITEXT CH="kama pakala. taso kisa mi li"/>
                <nbspace/>
                <ITEXT CH="ko ala li"/>
                <nbspace/>
                <ITEXT CH="lili ala li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kalama noka mute a. mi o"/>
                <nbspace/>
                <ITEXT CH="kepeken e"/>
                <nbspace/>
                <ITEXT CH="nimi seme tawa ona?"/>
                <para/>
                <ITEXT CH="ante la nimi mute li"/>
                <nbspace/>
                <ITEXT CH="kama suli tan ni: jan li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: mi jan Nimi ala – mi kisa Nimi. anu melome Nimi. ni la jan li"/>
                <nbspace/>
                <ITEXT CH="toki tawa ona la ona li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ni: sina kisa a? kisa li"/>
                <nbspace/>
                <ITEXT CH="seme? a kisa li"/>
                <nbspace/>
                <ITEXT CH="soweli. ona li"/>
                <nbspace/>
                <ITEXT CH="sama sitelen esun pi nimi sin."/>
                <para/>
                <ITEXT CH="ijo suli li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="nimi. kijetesantakalu en puwa en kisa en misa li"/>
                <nbspace/>
                <ITEXT CH="suli a tawa jan."/>
                <para/>
                <ITEXT CH="pilin mi la kulupu pi lipu Linku li"/>
                <nbspace/>
                <ITEXT CH="kama sona pona e"/>
                <nbspace/>
                <ITEXT CH="nasin toki pi jan pi toki pona. pona mute tawa kala Asi, tawa mun Kekan San – sina pali pona."/>
                <para/>
                <ITEXT CH="¹ mi pana e"/>
                <nbspace/>
                <ITEXT CH="nimi “nasin Kisa” tawa nasin lon poka tomo mi. ni li"/>
                <nbspace/>
                <ITEXT CH="suli ala tawa toki ni, taso ni li"/>
                <nbspace/>
                <ITEXT CH="musi tawa mi."/>
