                <nbspace/>
                <ITEXT CH="sona sina pi nimi mute pi nimi "/>
                <ITEXT CPARENT="Text723_Italic" CH="suli"/>
                <ITEXT CH=" ale. jan ante li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="sona tawa nimi mute ante. pini la jan pi nanpa suli li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="sona ona tawa nimi "/>
                <ITEXT CPARENT="Text723_Italic" CH="suli"/>
                <ITEXT CH=" ale."/>
                <para/>
                <ITEXT CH="ante ni li"/>
                <nbspace/>
                <ITEXT CH="pona tan ni: tenpo pini la lupa nanpa suli li"/>
                <nbspace/>
                <ITEXT CH="lon: nanpa pi nimi “ale” li"/>
                <nbspace/>
                <ITEXT CH="MMMMLLTW (93). ona li"/>
