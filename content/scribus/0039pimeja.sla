        <PAGEOBJECT XPOS="589.606299212598" YPOS="4899.6865391826" OwnPage="14" ItemID="883296432" PTYPE="4" WIDTH="170.078543307087" HEIGHT="259.368578927635" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 259.369 L0 259.369 L0 0 Z" copath="M0 0 L170.079 0 L170.079 259.369 L0 259.369 L0 0 Z" gXpos="589.606299212598" gYpos="4899.6865391826" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="883302096" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100" CH="jan sona li"/>
                <nbspace CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100" CH="wile kama sona e"/>
                <nbspace CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100" CH="sewi pimeja e"/>
                <nbspace CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text507_Bold" FCOLOR="loje pimeja" FSHADE="100" CH="mun."/>
                <ITEXT CH=" tan tenpo pini suli la, jan sona li"/>
                <nbspace/>
                <ITEXT CH="tawa sewi pimeja li"/>
                <nbspace/>
                <ITEXT CH="awen lon tomo sewi. tomo ni li"/>
                <nbspace/>
                <ITEXT CH="mun ilo suli li"/>
                <nbspace/>
                <ITEXT CH="sike e"/>
                <nbspace/>
                <ITEXT CH="ma. tan ni la, jan sona li"/>
                <nbspace/>
                <ITEXT CH="pilin ala e"/>
                <nbspace/>
                <ITEXT CH="wawa anpa, li"/>
                <nbspace/>
                <ITEXT CH="awen lon kon. jan sona pi ma ante mute li"/>
                <nbspace/>
                <ITEXT CH="kepeken tomo sewi tan ni: lon ni la jan li"/>
                <nbspace/>
                <ITEXT CH="kama sona e"/>
                <nbspace/>
                <ITEXT CH="ijo suli pi mun ale."/>
                <para/>
                <ITEXT CH="taso, tomo sewi li"/>
                <nbspace/>
                <ITEXT CH="kepeken e"/>
                <nbspace/>
                <ITEXT CH="mani mute tawa pali pona, tawa moku, tawa telo, tawa len, tawa ijo ante mute. ale li"/>
                <nbspace/>
                <ITEXT CH="tawa sewi kepeken tomo tawa sewi pi mani suli. kin la, tomo sewi li"/>
                <nbspace/>
                <ITEXT CH="kama majuna¹ la, ilo ona li"/>
                <nbspace/>
                <ITEXT CH="kama pakala lon tenpo kama lili. tan ni la, jan pi ma ale li"/>
                <nbspace/>
                <ITEXT CH="pilin e"/>
                <nbspace/>
                <ITEXT CH="ni: tenpo kama la tomo ni o"/>
                <nbspace/>
                <ITEXT CH="awen ala lon sewi pimeja. tomo ni li"/>
                <nbspace/>
                <ITEXT CH="weka la, jan sona li"/>
                <nbspace/>
                <ITEXT CH="ken ala awen lon sewi."/>
                <para/>
                <ITEXT CH="kulupu lawa pi ma ale li"/>
                <nbspace/>
                <ITEXT CH="wile ala pana e"/>
                <nbspace/>
                <ITEXT CH="mani mute tawa tomo sewi sin. taso, jan sona li"/>
                <nbspace/>
                <ITEXT CH="tawa sewi pimeja kepeken nasin seme a? jan li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: tenpo kama la, jan esun li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="mani tawa tomo sewi sin. mi la, ni li"/>
                <nbspace/>
                <ITEXT CH="nasin pona ala tan ni: jan esun pi mani mute li"/>
                <nbspace/>
                <ITEXT CH="kama jo e"/>
                <nbspace/>
                <ITEXT CH="wawa li"/>
                <nbspace/>
                <ITEXT CH="lawa e"/>
                <nbspace/>
                <ITEXT CH="sewi pimeja."/>
                <para/>
                <ITEXT CH="tomo sewi sin o"/>
                <nbspace/>
                <ITEXT CH="lili o"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="pakala lili. ni li"/>
                <nbspace/>
                <ITEXT CH="suli tawa pali pi jan sona. nasin ni la, mi mute li"/>
                <nbspace/>
                <ITEXT CH="awen sona e"/>
                <nbspace/>
                <ITEXT CH="ijo sin pi sewi pimeja. ken la, jan li"/>
                <nbspace/>
                <ITEXT CH="weka tan ma li"/>
                <nbspace/>
                <ITEXT CH="tawa mun Luna anu mun Masi kepeken sona tan tomo sewi sin."/>
                <para/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="¹ "/>
                <ITEXT CPARENT="Text507_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="majuna"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH=" li"/>
                <nbspace FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100"/>
                <ITEXT CPARENT="Text507_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="sin ala"/>
                <para PARENT="toki lili poka"/>
            </StoryText>
        </PAGEOBJECT>
