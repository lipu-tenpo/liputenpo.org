        <PAGEOBJECT XPOS="364.25193503937" YPOS="2477.48031496063" OwnPage="5" ItemID="242840224" PTYPE="4" WIDTH="170.078543307087" HEIGHT="73.7007874015749" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 73.7008 L0 73.7008 L0 0 Z" copath="M0 0 L170.079 0 L170.079 73.7008 L0 73.7008 L0 0 Z" gXpos="364.25193503937" gYpos="2477.48031496063" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="242862880" BACKITEM="242837392"/>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="2752.88863892013" OwnPage="8" ItemID="242826064" PTYPE="4" WIDTH="170.078606299213" HEIGHT="450.260967379078" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 450.261 L0 450.261 L0 0 Z" copath="M0 0 L170.079 0 L170.079 450.261 L0 450.261 L0 0 Z" gXpos="589.606299212598" gYpos="2752.88863892013" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="242854384" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text430_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="tomo mama mi la ma kasi li"/>
                <nbspace CPARENT="Text430_Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text430_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="lon poka tu."/>
                <ITEXT CH=" kule ona li"/>
                <nbspace/>
                <ITEXT CH="sama ala lon tenpo ale: sewi li"/>
                <nbspace/>
                <ITEXT CH="ante e"/>
                <nbspace/>
                <ITEXT CH="ma lon tenpo mute. tenpo pini la seli utala li"/>
                <nbspace/>
                <ITEXT CH="awen, la suno suli en telo lili li"/>
                <nbspace/>
                <ITEXT CH="kama jelo e"/>
                <nbspace/>
                <ITEXT CH="ma. taso tenpo sin la telo sin li"/>
                <nbspace/>
                <ITEXT CH="kama tan sewi; la laso sin li"/>
                <nbspace/>
                <ITEXT CH="kama lon ma. telo en ma la ni li"/>
                <nbspace/>
                <ITEXT CH="nasin pona."/>
                <para/>
                <ITEXT CH="mi weka e"/>
                <nbspace/>
                <ITEXT CH="len lape la mi ken kute: tawa telo li"/>
                <nbspace/>
                <ITEXT CH="moku e"/>
                <nbspace/>
                <ITEXT CH="kalama ale. ni la laso sin o"/>
                <nbspace/>
                <ITEXT CH="lon! lukin mi li"/>
                <nbspace/>
                <ITEXT CH="alasa lon lupa tomo - a, telo li"/>
                <nbspace/>
                <ITEXT CH="lon sewi ale. taso anpa la ma li"/>
                <nbspace/>
                <ITEXT CH="laso lili a… pimeja lili mute a li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="ona, li"/>
                <nbspace/>
                <ITEXT CH="tawa lon ona, li"/>
                <nbspace/>
                <ITEXT CH="open e"/>
                <nbspace/>
                <ITEXT CH="lupa lon ona. tenpo ni la telo li"/>
                <nbspace/>
                <ITEXT CH="wawa tu: ona li"/>
                <nbspace/>
                <ITEXT CH="laso e"/>
                <nbspace/>
                <ITEXT CH="ma, li"/>
                <nbspace/>
                <ITEXT CH="waso e"/>
                <nbspace/>
                <ITEXT CH="ma."/>
                <para/>
                <ITEXT CH="waso pimeja la ma mi li"/>
                <nbspace/>
                <ITEXT CH="poki moku. uta kiwen ale ona li"/>
                <nbspace/>
                <ITEXT CH="pakala lupa e"/>
                <nbspace/>
                <ITEXT CH="ma, li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="pipi kama. waso li"/>
                <nbspace/>
                <ITEXT CH="ni lon tenpo telo a tan sona nasa: telo li"/>
                <nbspace/>
                <ITEXT CH="tawa anpa, la pipi ma li"/>
                <nbspace/>
                <ITEXT CH="tawa sewi. pipi li"/>
                <nbspace/>
                <ITEXT CH="ken pilin e"/>
                <nbspace/>
                <ITEXT CH="mu telo lon sewi ona, li"/>
                <nbspace/>
                <ITEXT CH="wile tawa ona. nasin ni la telo li"/>
                <nbspace/>
                <ITEXT CH="kama e"/>
                <nbspace/>
                <ITEXT CH="ona tan insa ma (tawa insa waso)."/>
                <para/>
                <ITEXT CH="waso ale ni la len li"/>
                <nbspace/>
                <ITEXT CH="pimeja. taso len ale li"/>
                <nbspace/>
                <ITEXT CH="sama ala: mi lukin e"/>
                <nbspace/>
                <ITEXT CH="ante lili mute lon sijelo ona. kulupu wan li"/>
                <nbspace/>
                <ITEXT CH="walo lon len sinpin; kulupu ante li"/>
                <nbspace/>
                <ITEXT CH="pimeja laso lon len ale, li"/>
                <nbspace/>
                <ITEXT CH="pimeja walo lon selo uta; luka li"/>
                <nbspace/>
                <ITEXT CH="ken suli li"/>
                <nbspace/>
                <ITEXT CH="ken lili; uta li"/>
                <nbspace/>
                <ITEXT CH="ken nena li"/>
                <nbspace/>
                <ITEXT CH="ken palisa. kulupu mute ni li"/>
                <nbspace/>
                <ITEXT CH="kama tan mama ante, taso ona ale li"/>
                <nbspace/>
                <ITEXT CH="kama wan lon tenpo alasa. lukin la ni li"/>
                <nbspace/>
                <ITEXT CH="pona e"/>
                <nbspace/>
                <ITEXT CH="pali ona. waso ni en waso ni li"/>
                <nbspace/>
                <ITEXT CH="moku; waso ante li"/>
                <nbspace/>
                <ITEXT CH="awen lon sewi kasi, li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="ijo ike (e"/>
                <nbspace/>
                <ITEXT CH="waso wawa ante, e"/>
                <nbspace/>
                <ITEXT CH="soweli, e"/>
                <nbspace/>
                <ITEXT CH="jan), li"/>
                <nbspace/>
                <ITEXT CH="awen e"/>
                <nbspace/>
                <ITEXT CH="waso ma. ijo li"/>
                <nbspace/>
                <ITEXT CH="kama la ona li"/>
                <nbspace/>
                <ITEXT CH="mu e"/>
                <nbspace/>
                <ITEXT CH="ni tawa ale."/>
                <para/>
                <ITEXT CH="sewi li"/>
                <nbspace/>
                <ITEXT CH="kama telo ala, la len waso li"/>
                <nbspace/>
                <ITEXT CH="kama pimeja ante. suno wawa la laso en loje li"/>
                <nbspace/>
                <ITEXT CH="ken tawa musi lon selo len. taso waso li"/>
                <nbspace/>
                <ITEXT CH="tawa lili - ni la pimeja li"/>
                <nbspace/>
                <ITEXT CH="kama sin. mi lukin e"/>
                <nbspace/>
                <ITEXT CH="len sama tan poka ante: kule li"/>
                <nbspace/>
                <ITEXT CH="kama ante tan seme?"/>
                <para/>
                <ITEXT CH="lon la ni li"/>
                <nbspace/>
                <ITEXT CH="nasa a tawa mi. mi sona toki e"/>
                <nbspace/>
                <ITEXT CH="ni taso: len waso li"/>
                <nbspace/>
                <ITEXT CH="sama ala len ante. lon selo ale waso la palisa mute li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="lipu pimeja mute. lipu wan la insa li"/>
                <nbspace/>
                <ITEXT CH="sama linja lili mute a. linja wan en linja ante li"/>
                <nbspace/>
                <ITEXT CH="lon poka, li"/>
                <nbspace/>
                <ITEXT CH="ken awen lon poka tan nena mute lon pini linja. kulupu linja li"/>
                <nbspace/>
                <ITEXT CH="ken sama selo lili; ni la selo mute a li"/>
                <nbspace/>
                <ITEXT CH="kama e"/>
                <nbspace/>
                <ITEXT CH="lipu len."/>
                <para/>
                <ITEXT CH="len nasa ni la suno kin li"/>
                <nbspace/>
                <ITEXT CH="kama nasa. sona pona la sike suno li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="wawa tawa ale. ijo ale la selo li"/>
                <nbspace/>
                <ITEXT CH="ken pana sin e"/>
                <nbspace/>
                <ITEXT CH="wawa ni, li"/>
                <nbspace/>
                <ITEXT CH="ken weka e"/>
                <nbspace/>
                <ITEXT CH="ona. pana la ona li"/>
                <nbspace/>
                <ITEXT CH="kama kule; weka la ona li"/>
                <nbspace/>
                <ITEXT CH="pimeja. ni la len waso li"/>
                <nbspace/>
                <ITEXT CH="pana ala pana e"/>
                <nbspace/>
                <ITEXT CH="suno? sona pona la ona li"/>
                <nbspace/>
                <ITEXT CH="pimeja, li"/>
                <nbspace/>
                <ITEXT CH="pana ala. taso mi o"/>
                <nbspace/>
                <ITEXT CH="awen sona e"/>
                <nbspace/>
                <ITEXT CH="insa len: wawa suno li"/>
                <nbspace/>
                <ITEXT CH="kama lon lipu ale, lon selo lili ale, lon linja lili ale. suno li"/>
                <nbspace/>
                <ITEXT CH="ken tawa lon lili ale ni kepeken nasin nasa taso! ni la selo wan li"/>
                <nbspace/>
                <ITEXT CH="ken pana e"/>
                <nbspace/>
                <ITEXT CH="kule tawa poka wan, tawa ala poka ante. kule li"/>
                <nbspace/>
                <ITEXT CH="open li"/>
                <nbspace/>
                <ITEXT CH="pini lon tawa lili wan. waso li"/>
                <nbspace/>
                <ITEXT CH="wawa a."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
