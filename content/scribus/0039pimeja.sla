            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CH="oko¹ sina la mi pimeja"/>
                <breakline/>
                <ITEXT CH="taso pimeja li kule mi ala"/>
                <breakline/>
                <ITEXT CH="suno li kama ala tan insa mi"/>
                <breakline/>
                <ITEXT CH="taso nasin suno li ante tan mi"/>
                <para/>
                <ITEXT CH="wawa mi li suli mute"/>
                <breakline/>
                <ITEXT CH="poka mi la ijo li ken tawa sike"/>
                <breakline/>
                <ITEXT CH="taso ijo li tawa insa pi selo mi la"/>
                <breakline/>
                <ITEXT CH="ona li ken ala weka"/>
                <para/>
                <ITEXT CH="pona la mi weka mute tan sina"/>
                <breakline/>
                <ITEXT CH="poka mi la lon li kama nasa"/>
                <breakline/>
                <ITEXT CH="jan sona li sona ala e insa mi"/>
                <breakline/>
                <ITEXT CH="poka mi la tenpo li tawa lili"/>
                <para/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="¹ "/>
                <ITEXT CPARENT="Text521_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="oko"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH=" li "/>
                <ITEXT CPARENT="Text521_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="sike lukin"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH=" lon lawa sina"/>
                <para PARENT="toki lili poka"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606236220472" YPOS="5517.24634420697" OwnPage="16" ItemID="883259616" PTYPE="2" WIDTH="199.038633952006" HEIGHT="293.77727784027" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" path="M0 0 L199.039 0 L199.039 293.777 L0 293.777 L0 0 Z" copath="M0 0 L199.039 0 L199.039 293.777 L0 293.777 L0 0 Z" gXpos="589.606236220472" gYpos="5517.24634420697" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
