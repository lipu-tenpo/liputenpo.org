            <PAGEOBJECT XPOS="483.639697247423" YPOS="5315.67628667672" OwnPage="19" ItemID="215318576" PTYPE="7" WIDTH="0" HEIGHT="12.5698468702926" FRTYPE="3" CLIPEDIT="1" PWIDTH="0.515606349159804" PCOLOR="kapesi walo" PCOLOR2="Black" PLINEART="1" ANNAME=" line27" TEXTFLOWMODE="1" path="M0 12.5699 L0 0 " copath="M0 12.5699 L0 0 L0 12.5699 Z" gXpos="61.7276158532205" gYpos="0.801690738073376" gWidth="68.4939706815455" gHeight="14.1732283464398" LAYER="0"/>
            <PAGEOBJECT XPOS="485.086044148537" YPOS="5315.67628667672" OwnPage="19" ItemID="215335568" PTYPE="7" WIDTH="0" HEIGHT="12.5698538727618" FRTYPE="3" CLIPEDIT="1" PWIDTH="0.515606349159804" PCOLOR="kapesi walo" PCOLOR2="Black" PLINEART="1" ANNAME=" line28" TEXTFLOWMODE="1" path="M0 12.5699 L0 0 " copath="M0 12.5699 L0 0 L0 12.5699 Z" gXpos="63.1739627543337" gYpos="0.801690738073376" gWidth="68.4939706815455" gHeight="14.1732283464398" LAYER="0"/>
            <PAGEOBJECT XPOS="488.701902000055" YPOS="5315.67628667672" OwnPage="19" ItemID="215344064" PTYPE="7" WIDTH="0" HEIGHT="12.5698468702926" FRTYPE="3" CLIPEDIT="1" PWIDTH="0.515606349159804" PCOLOR="kapesi walo" PCOLOR2="Black" PLINEART="1" ANNAME=" line29" TEXTFLOWMODE="1" path="M0 12.5699 L0 0 " copath="M0 12.5699 L0 0 L0 12.5699 Z" gXpos="66.7898206058524" gYpos="0.801690738073376" gWidth="68.4939706815455" gHeight="14.1732283464398" LAYER="0"/>
            <PAGEOBJECT XPOS="490.148248901169" YPOS="5315.67628667672" OwnPage="19" ItemID="215332736" PTYPE="7" WIDTH="0" HEIGHT="12.5698468702926" FRTYPE="3" CLIPEDIT="1" PWIDTH="0.515606349159804" PCOLOR="kapesi walo" PCOLOR2="Black" PLINEART="1" ANNAME=" line30" TEXTFLOWMODE="1" path="M0 12.5699 L0 0 " copath="M0 12.5699 L0 0 L0 12.5699 Z" gXpos="68.2361675069656" gYpos="0.801690738073376" gWidth="68.4939706815455" gHeight="14.1732283464398" LAYER="0"/>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="834.162729658793" OwnPage="2" ItemID="215338400" PTYPE="4" WIDTH="170.078543307087" HEIGHT="413.081364829397" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 413.081 L0 413.081 L0 0 Z" copath="M0 0 L170.079 0 L170.079 413.081 L0 413.081 L0 0 Z" gXpos="589.606299212598" gYpos="834.162729658793" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="215341232" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text67_Bold" FCOLOR="jelo pimeja" FSHADE="100" CH="kulupu li"/>
                <nbspace CPARENT="Text67_Bold" FCOLOR="jelo pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text67_Bold" FCOLOR="jelo pimeja" FSHADE="100" CH="kama lon ma wan"/>
                <ITEXT CH=" lon tenpo sike ale. tenpo ni la kulupu li"/>
                <nbspace/>
                <ITEXT CH="lon ma tomo Sijana. taso ni la seme? mi wile pana e"/>
                <nbspace/>
                <ITEXT CH="sona ni. ken la ni li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="wile kama tawa sina kin a!"/>
                <para/>
                <ITEXT CH="musi kulupu"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="ijo musi mute li"/>
                <nbspace/>
                <ITEXT CH="lon tenpo kulupu ni. jan mute li"/>
                <nbspace/>
                <ITEXT CH="ante toki e"/>
                <nbspace/>
                <ITEXT CH="musi lipu anu musi supa lon tenpo ni anu tenpo pini. mi ken musi mute kepeken toki pona tan ni. mi ale li"/>
                <nbspace/>
                <ITEXT CH="ni lon tenpo mute. tenpo la mi sitelen kule. tenpo ante la mi pali e"/>
                <nbspace/>
                <ITEXT CH="nasin sitelen nasa. musi suli la supa suli li"/>
                <nbspace/>
                <ITEXT CH="lon. lon supa suli la jan li"/>
                <nbspace/>
                <ITEXT CH="ken musi sama ni: ona li"/>
                <nbspace/>
                <ITEXT CH="toki sama jan tan lipu pi lon ala li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="toki tan lipu ni. tenpo kulupu ni la jan li"/>
                <nbspace/>
                <ITEXT CH="pana musi pi lipu &quot;tu kuntu&quot;. kin la kalama pona li"/>
                <nbspace/>
                <ITEXT CH="lon. jan li"/>
                <nbspace/>
                <ITEXT CH="ante toki e"/>
                <nbspace/>
                <ITEXT CH="kalama tawa toki pona. lon la kulupu pi jan luka (mi lon kulupu ni) li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kalama ni tawa jan ale pi kulupu tu. mi pilin monsuta suli tan ni a a."/>
                <para/>
                <ITEXT CH="toki tu"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="wan pi kulupu toki tu kin li"/>
                <nbspace/>
                <ITEXT CH="musi a! tenpo kulupu ni la toki tu li"/>
                <nbspace/>
                <ITEXT CH="lon: jan li"/>
                <nbspace/>
                <ITEXT CH="toki pona li"/>
                <nbspace/>
                <ITEXT CH="toki Epelanto. open la ni li"/>
                <nbspace/>
                <ITEXT CH="ken nasa lili. lipu mute lon tomo kulupu li"/>
                <nbspace/>
                <ITEXT CH="kepeken toki Epelanto taso. jan mute li"/>
                <nbspace/>
                <ITEXT CH="ken ala sona e"/>
                <nbspace/>
                <ITEXT CH="lipu tan ni. taso jan pi kulupu ni li"/>
                <nbspace/>
                <ITEXT CH="pona li"/>
                <nbspace/>
                <ITEXT CH="suwi. kulupu tu li"/>
                <nbspace/>
                <ITEXT CH="poka lon tenpo ale. jan pi toki Epelanto li"/>
                <nbspace/>
                <ITEXT CH="kama sona e"/>
                <nbspace/>
                <ITEXT CH="toki pona. jan pi toki pona li"/>
                <nbspace/>
                <ITEXT CH="kama sona e"/>
                <nbspace/>
                <ITEXT CH="toki Epelanto. lon tenpo pimeja la jan li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kalama musi la jan ale pi toki tu li"/>
                <nbspace/>
                <ITEXT CH="musi lon poka. tenpo la mi ken ala toki tawa jan ante tan ni: ona li"/>
                <nbspace/>
                <ITEXT CH="ken toki Epelanto taso. taso jan mute pi toki tu li"/>
                <nbspace/>
                <ITEXT CH="lon. mi ken toki e"/>
                <nbspace/>
                <ITEXT CH="ni tawa ona: &quot;o"/>
                <nbspace/>
                <ITEXT CH="ante e"/>
                <nbspace/>
                <ITEXT CH="toki mi!&quot; ni li"/>
                <nbspace/>
                <ITEXT CH="ken ike lili. taso mi la ni li"/>
                <nbspace/>
                <ITEXT CH="musi pona. jan mute pi toki pona li"/>
                <nbspace/>
                <ITEXT CH="musi supa. jan ante li"/>
                <nbspace/>
                <ITEXT CH="kama li"/>
                <nbspace/>
                <ITEXT CH="wile musi. ona li"/>
                <nbspace/>
                <ITEXT CH="ken toki pona ala. taso ona li"/>
                <nbspace/>
                <ITEXT CH="alasa musi pi toki pona. tan pona kulupu ni la mi kama poka pi jan ante mute. lon a, mi open kama sona toki Epelanto tan tenpo kulupu ni!"/>
                <para/>
                <ITEXT CH="musi nasa"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="sama tenpo ale la kulupu li"/>
                <nbspace/>
                <ITEXT CH="nasa pona suli li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="ijo nasa mute. musi sin li"/>
                <nbspace/>
                <ITEXT CH="kama lon: ni li"/>
                <nbspace/>
                <ITEXT CH="musi &quot;sinpin monsi&quot;. jan wan li"/>
                <nbspace/>
                <ITEXT CH="lon insa pi sike jan. jan wan ante o"/>
                <nbspace/>
                <ITEXT CH="supa e"/>
                <nbspace/>
                <ITEXT CH="poki telo lon sijelo ona. jan ante ale li"/>
                <nbspace/>
                <ITEXT CH="lon sike li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: &quot;sinpin. monsi. sinpin. monsi.&quot; ni li"/>
                <nbspace/>
                <ITEXT CH="musi tan seme? mi sona ala. taso ni li"/>
                <nbspace/>
                <ITEXT CH="musi a. jan li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="nimi nasa mute. nimi ni li"/>
                <nbspace/>
                <ITEXT CH="nasa suli la sina ken sona ala e"/>
                <nbspace/>
                <ITEXT CH="ona. ni la jan poka sina &quot;li"/>
                <nbspace/>
                <ITEXT CH="sun e"/>
                <nbspace/>
                <ITEXT CH="akuliki sulili&quot; la sina ken sona e"/>
                <nbspace/>
                <ITEXT CH="ni: ona li"/>
                <nbspace/>
                <ITEXT CH="kepeken e"/>
                <nbspace/>
                <ITEXT CH="nimi pi tenpo kulupu ni."/>
                <para/>
                <ITEXT CH="tenpo pona"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="tenpo seme li"/>
                <nbspace/>
                <ITEXT CH="pona nanpa wan tawa mi? mi tawa ma Talakona lon tenpo suno pi len suno. jan ante luka kin li"/>
                <nbspace/>
                <ITEXT CH="lon. len suno la jan ale li"/>
                <nbspace/>
                <ITEXT CH="wile ma Talakona. ni la mi ken ala lon insa pi tomo tawa. jan pi mute ike li"/>
                <nbspace/>
                <ITEXT CH="lon insa ona. tomo tawa ante li"/>
                <nbspace/>
                <ITEXT CH="kama la jan mute li"/>
                <nbspace/>
                <ITEXT CH="awen lon. jan ante li"/>
                <nbspace/>
                <ITEXT CH="lon la mi ken toki li"/>
                <nbspace/>
                <ITEXT CH="ken musi. taso seli li"/>
                <nbspace/>
                <ITEXT CH="lili e"/>
                <nbspace/>
                <ITEXT CH="musi ni. mi ale li"/>
                <nbspace/>
                <ITEXT CH="moku la jan ante li"/>
                <nbspace/>
                <ITEXT CH="kute e"/>
                <nbspace/>
                <ITEXT CH="kalama mi li"/>
                <nbspace/>
                <ITEXT CH="wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni: mi kepeken toki seme? ni la mi pana e"/>
                <nbspace/>
                <ITEXT CH="sona mute pi toki pona tawa ona. ken la ona li"/>
                <nbspace/>
                <ITEXT CH="kama sona toki pona tan ni. kulupu ni la mi musi suli li"/>
                <nbspace/>
                <ITEXT CH="kama pilin poka pona. mi wile awen sona e"/>
                <nbspace/>
                <ITEXT CH="musi pi kulupu ni lon tenpo ale."/>
                <para/>
                <ITEXT CH="tenpo kulupu ni li"/>
                <nbspace/>
                <ITEXT CH="pona suli tawa mi. mi wile a kama lon tenpo kama li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="ni: jan pona mute kin li"/>
                <nbspace/>
                <ITEXT CH="lon."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="773.857842519685" YPOS="847.55905511811" OwnPage="2" ItemID="215341232" PTYPE="4" WIDTH="170.079165354331" HEIGHT="399.685039370079" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 399.685 L0 399.685 L0 0 Z" copath="M0 0 L170.079 0 L170.079 399.685 L0 399.685 L0 0 Z" gXpos="773.857842519685" gYpos="847.55905511811" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="215910016" BACKITEM="215338400"/>
