        <PAGEOBJECT XPOS="280.629657480315" YPOS="5272.44094488189" OwnPage="15" ItemID="883387056" PTYPE="4" WIDTH="170.078543307087" HEIGHT="51.0236220472441" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 51.0236 L0 51.0236 L0 0 Z" copath="M0 0 L170.079 0 L170.079 51.0236 L0 51.0236 L0 0 Z" gXpos="55.7943111173601" gYpos="-56.1979752530924" gWidth="170.078543307087" gHeight="76.535433070866" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FCOLOR="unu pimeja" FSHADE="100" CH="musi pimeja"/>
                <trail PARENT="lawa" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="178.582677165354" YPOS="5339.06861642295" OwnPage="15" ItemID="883384224" PTYPE="4" WIDTH="170.078606299213" HEIGHT="471.955005624297" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 471.955 L0 471.955 L0 0 Z" copath="M0 0 L170.079 0 L170.079 471.955 L0 471.955 L0 0 Z" gXpos="178.582677165354" gYpos="5339.06861642295" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="883401216" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CH="nimi pi mute lili li"/>
                <nbspace/>
                <ITEXT CH="ken pana e"/>
                <nbspace/>
                <ITEXT CH="pilin mute tawa jan. musi pimeja anu musi pi toki pimeja (toki Inli la "/>
                <ITEXT CPARENT="Text539_Italic" CH="Black Stories"/>
                <ITEXT CH=") la musi li"/>
                <nbspace/>
                <ITEXT CH="kepeken e"/>
                <nbspace/>
                <ITEXT CH="nasin ni:"/>
                <para/>
                <ITEXT CH="jan toki wan li"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="ale pi toki pimeja. taso open la ona li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="toki lili taso. kulupu li"/>
                <nbspace/>
                <ITEXT CH="wile kama sona e"/>
                <nbspace/>
                <ITEXT CH="ni: seme li"/>
                <nbspace/>
                <ITEXT CH="lon?"/>
                <para/>
                <ITEXT CH="taso kulupu li"/>
                <nbspace/>
                <ITEXT CH="ken ala toki e"/>
                <nbspace/>
                <ITEXT CH="wile sona sama ni: “seme li"/>
                <nbspace/>
                <ITEXT CH="lon?”. ona li"/>
                <nbspace/>
                <ITEXT CH="ken pana taso e"/>
                <nbspace/>
                <ITEXT CH="wile sona sama ni: “ijo ni li"/>
                <nbspace/>
                <ITEXT CH="lon ala lon?”, “ona li"/>
                <nbspace/>
                <ITEXT CH="wile ala wile pali e"/>
                <nbspace/>
                <ITEXT CH="ni?” anu “jan ni li"/>
                <nbspace/>
                <ITEXT CH="pali ala pali e"/>
                <nbspace/>
                <ITEXT CH="ni?”"/>
                <para/>
                <ITEXT CH="jan toki li"/>
                <nbspace/>
                <ITEXT CH="ken toki taso e"/>
                <nbspace/>
                <ITEXT CH="ni: “lon/lon ala”, “wile/wile ala” anu “pali/pali ala”. kin la ona li"/>
                <nbspace/>
                <ITEXT CH="ken toki e"/>
                <nbspace/>
                <ITEXT CH="ni: “ni li"/>
                <nbspace/>
                <ITEXT CH="suli ala”. kulupu li"/>
                <nbspace/>
                <ITEXT CH="kepeken e"/>
                <nbspace/>
                <ITEXT CH="wile sona li"/>
                <nbspace/>
                <ITEXT CH="kama sona lili e"/>
                <nbspace/>
                <ITEXT CH="sona ale pi toki pimeja."/>
                <para/>
                <ITEXT CH="mute la toki pimeja li"/>
                <nbspace/>
                <ITEXT CH="monsuta. jan li"/>
                <nbspace/>
                <ITEXT CH="moli lon toki mute. taso toki pimeja pi moli ala li"/>
                <nbspace/>
                <ITEXT CH="lon kin."/>
                <para/>
                <ITEXT CH="ken mute la sina sona ala e kon pi toki mi. ni la mi wile pana e nasin wan pi musi ni:"/>
                <para/>
                <ITEXT CPARENT="Text539_Bold" CH="suno"/>
                <para/>
                <ITEXT CH="jan toki: “jan li pini e suno. kama la pakala suli li lon. tan seme?”"/>
                <para/>
                <ITEXT CH="kulupu: “suno li suli ala suli?”"/>
                <breakline/>
                <ITEXT CH="jan toki: “suli.”"/>
                <para/>
                <ITEXT CH="kulupu: “jan li sona ala sona e jan pakala?”"/>
                <breakline/>
                <ITEXT CH="jan toki: “sona ala.”"/>
                <para/>
                <ITEXT CH="kulupu: “jan li wile ala wile pakala e jan?”"/>
                <breakline/>
                <ITEXT CH="jan toki: “wile ala.”"/>
                <para/>
                <ITEXT CH="kulupu: “suno li ilo ala ilo?”"/>
                <breakline/>
                <ITEXT CH="jan toki: “ilo.”"/>
                <para/>
                <ITEXT CH="kulupu li toki e wile sona ante mute. kama la ona li kama sona e ni:"/>
                <para/>
                <ITEXT CPARENT="Text539_Bold" CH="pini"/>
                <ITEXT CH=": jan ni li pali lon tomo suno pi poka telo. ona li pini e suno suli tan ni: ona li pilin lape. tenpo pimeja la jan pi tomo tawa telo li lukin ala e suno li sona ala e ni: ma li lon. tomo telo li pakala."/>
                <para/>
                <ITEXT CH="pona a! tenpo ni la sina sona e nasin musi pi musi pimeja. mi wile pana e toki pimeja tu. ken la sina ken musi e musi pimeja lon tenpo kama lon poka pi jan ante:"/>
                <para/>
                <ITEXT CPARENT="Text539_Bold" CH="nanpa wan: soweli"/>
                <para/>
                <ITEXT CH="jan Te li tawa lon nasin kepeken tomo tawa. ona li lukin e soweli a. kama la jan pi awen lawa li toki tawa jan Te e ni: “sina jan pona!”"/>
                <para/>
                <ITEXT CPARENT="Text539_Italic" CH="soweli ni li soweli lon ala. ona li soweli powe. jan Te li lukin e soweli ni, li awen e tomo tawa, li alasa lon ma poka. poka pi soweli powe la jan lili li lon. ona li pakala tan ni: sike tu ona li pakala. jan Te li toki tawa jan pi awen lawa. mama pi jan lili li alasa e ona lon ma ale. pona la jan Te li alasa e ona. ni la jan lili li ken kama sin lon poka pi mama ona."/>
                <para/>
                <ITEXT CPARENT="Text539_Bold" CH="nanpa tu: jan suli"/>
                <para/>
                <ITEXT CH="jan Kilo li jan suli. ike la ona li jan lili ala. ona o tawa lon telo tan ni: ona li suli. tan seme?"/>
                <para/>
                <ITEXT CPARENT="Text539_Italic" CH="jan Kilo li tawa lon sewi kepeken tomo pi kon seli. ona li tawa lon sewi pi telo suli. taso ilo seli li pakala. tomo kon li kama anpa. jan Kilo li weka e ijo ale tan tomo kon. taso tomo kon li awen tawa anpa. jan Kilo li jan suli a. taso ona li ken ala weka e ona tan tomo kon. tan ni la tomo kon li ken ala tawa ma poka telo. pini la tomo kon li kama lon telo. jan Kilo li weka tan tomo kon, li tawa lon telo tawa ma poka."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
