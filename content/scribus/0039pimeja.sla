        </PAGEOBJECT>
        <PAGEOBJECT XPOS="362.834283464567" YPOS="3349.97225346832" OwnPage="9" ItemID="242947840" PTYPE="4" WIDTH="170.079102362205" HEIGHT="505.145856767905" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 505.146 L0 505.146 L0 0 Z" copath="M0 0 L170.079 0 L170.079 505.146 L0 505.146 L0 0 Z" gXpos="362.834283464567" gYpos="3349.97225346832" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="242885536"/>
        <PAGEOBJECT XPOS="178.582677165354" YPOS="3664.9246344207" OwnPage="9" ItemID="242936512" PTYPE="2" WIDTH="170.07874015748" HEIGHT="170.07874015748" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.17007874015748" LOCALSCY="0.17007874015748" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../img/0039-nanpa-pimeja/jelo-en-laso-en-loje-li-lon-e-pimeja-kule.png" IRENDER="0" EMBEDDED="0" path="M0 0 L170.079 0 L170.079 170.079 L0 170.079 L0 0 Z" copath="M0 0 L170.079 0 L170.079 170.079 L0 170.079 L0 0 Z" gXpos="178.582677165354" gYpos="3664.9246344207" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="3429.92125984252" OwnPage="10" ItemID="242939344" PTYPE="4" WIDTH="170.078543307087" HEIGHT="126.527184101987" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 126.527 L0 126.527 L0 0 Z" copath="M0 0 L170.079 0 L170.079 126.527 L0 126.527 L0 0 Z" gXpos="589.606299212598" gYpos="3429.92125984252" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="242956336" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text456_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="lukin jan li"/>
                <nbspace CPARENT="Text456_Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text456_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ken pilin e"/>
                <nbspace CPARENT="Text456_Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text456_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="suno"/>
                <ITEXT CH=" kepeken ijo lili mute a. toki ni la, kulupu tu ni pi ijo lili li"/>
                <nbspace/>
                <ITEXT CH="suli: lili palisa en lili kule. ni la, palisa li"/>
                <nbspace/>
                <ITEXT CH="mute nanpa wan. ona li"/>
                <nbspace/>
                <ITEXT CH="pilin e"/>
                <nbspace/>
                <ITEXT CH="kule ale suno li"/>
                <nbspace/>
                <ITEXT CH="ken e"/>
                <nbspace/>
                <ITEXT CH="lukin lon pimeja. lili kule li"/>
                <nbspace/>
                <ITEXT CH="ken e"/>
                <nbspace/>
                <ITEXT CH="lukin kule. ona ale li"/>
                <nbspace/>
                <ITEXT CH="pilin suli e"/>
                <nbspace/>
                <ITEXT CH="wan taso pi kule ni: jelo en laso kasi en laso telo. lon anpa la, sina ken lukin e"/>
                <nbspace/>
                <ITEXT CH="wawa pilin pi lili kule tu wan tan kule suno ale."/>
                <para/>
                <ITEXT CH="ilo pi pana suno li"/>
                <nbspace/>
                <ITEXT CH="ken sama sitelen kepeken nasa ni pi lukin jan. loje en laso kasi en laso telo li"/>
                <nbspace/>
                <ITEXT CH="kule suli tawa kule suno. kepeken wan pi kule ni la, ilo li"/>
                <nbspace/>
                <ITEXT CH="ken pana e"/>
                <nbspace/>
                <ITEXT CH="kule mute a! ilo li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="wawa pi kule suli ante tawa ni: ona li"/>
                <nbspace/>
                <ITEXT CH="kama wan tawa jan li"/>
                <nbspace/>
                <ITEXT CH="sama kule wile. kule tu wan ni ale li"/>
                <nbspace/>
                <ITEXT CH="wawa nanpa wan la, suno li"/>
                <nbspace/>
                <ITEXT CH="sama walo. sama la, kule ala li"/>
                <nbspace/>
                <ITEXT CH="kama pimeja."/>
                <para/>
                <ITEXT CH="kin la ilo sitelen li"/>
                <nbspace/>
                <ITEXT CH="alasa kepeken ken jan wawa ni: lukin mi li"/>
                <nbspace/>
                <ITEXT CH="ken pilin e"/>
                <nbspace/>
                <ITEXT CH="ante lili a pimeja. jan li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ante pi suli suno la, ante pimeja li"/>
                <nbspace/>
                <ITEXT CH="suli tawa ante walo sama. ni la, pimeja li"/>
                <nbspace/>
                <ITEXT CH="kepeken sona mute tawa walo lon ilo."/>
                <para/>
                <ITEXT CH="nasin ni li"/>
                <nbspace/>
                <ITEXT CH="kepeken la, ona li"/>
                <nbspace/>
                <ITEXT CH="len pona e"/>
                <nbspace/>
                <ITEXT CH="selo lon insa pi suli pimeja ante. ni ala la, jan li"/>
                <nbspace/>
                <ITEXT CH="ken ike a lukin e"/>
                <nbspace/>
                <ITEXT CH="ijo lon pimeja lon sitelen ilo."/>
                <para/>
                <ITEXT CH="wawa la, ilo sina li"/>
                <nbspace/>
                <ITEXT CH="ni tu li"/>
                <nbspace/>
                <ITEXT CH="ante mute lon tenpo ale ni: ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="sitelen tawa sina. sina lukin e"/>
                <nbspace/>
                <ITEXT CH="ni lon ilo la, ona li"/>
                <nbspace/>
                <ITEXT CH="pali nanpa mute mute a kepeken tenpo lili tawa ni: ona li"/>
                <nbspace/>
                <ITEXT CH="sitelen e"/>
                <nbspace/>
                <ITEXT CH="toki ni e"/>
                <nbspace/>
                <ITEXT CH="sitelen e"/>
                <nbspace/>
                <ITEXT CH="kule e"/>
                <nbspace/>
                <ITEXT CH="walo e"/>
                <nbspace/>
                <ITEXT CH="pimeja li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="ona tawa sina. ona li"/>
                <nbspace/>
                <ITEXT CH="ni ale tawa lukin nasa mi tawa ni: sitelen li"/>
                <nbspace/>
                <ITEXT CH="ken nasa ala tawa lukin mi."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
