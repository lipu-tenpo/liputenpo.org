        <PAGEOBJECT XPOS="178.582645669292" YPOS="3409.78177727784" OwnPage="9" ItemID="242885536" PTYPE="4" WIDTH="170.078606299213" HEIGHT="255.142857142857" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 255.143 L0 255.143 L0 0 Z" copath="M0 0 L170.079 0 L170.079 255.143 L0 255.143 L0 0 Z" gXpos="178.582645669292" gYpos="3409.78177727784" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="242947840" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text451_Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-1" CH="sina wile kama jo e"/>
                <nbspace CPARENT="Text451_Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-1"/>
                <ITEXT CPARENT="Text451_Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-1" CH="lipu tenpo lon lipu lon."/>
                <ITEXT CH=" wile sina la, lipu li"/>
                <nbspace/>
                <ITEXT CH="kule ala li"/>
                <nbspace/>
                <ITEXT CH="pimeja li"/>
                <nbspace/>
                <ITEXT CH="walo taso. ni la, sina kepeken ilo sitelen. taso a, tenpo lili la, ilo sitelen li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: &quot;mi jo ala e"/>
                <nbspace/>
                <ITEXT CH="telo sitelen loje. mi ken ala sitelen e"/>
                <nbspace/>
                <ITEXT CH="ni.&quot;"/>
                <para/>
                <ITEXT CH="pilin sina la, ilo ni li"/>
                <nbspace/>
                <ITEXT CH="pakala. sina wile e"/>
                <nbspace/>
                <ITEXT CH="kule ala la, seme la ni li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="kule? ken la sina wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni kin: &quot;nasin seme la ilo sitelen li"/>
                <nbspace/>
                <ITEXT CH="sitelen e"/>
                <nbspace/>
                <ITEXT CH="kule? ona li"/>
                <nbspace/>
                <ITEXT CH="jo ala e"/>
                <nbspace/>
                <ITEXT CH="telo sitelen pi kule ale a.&quot;"/>
                <para/>
                <ITEXT CH="nanpa wan la, sina lukin e"/>
                <nbspace/>
                <ITEXT CH="poki kule pi ilo sitelen sina. sina sitelen lon lipu lon la, sina sona e"/>
                <nbspace/>
                <ITEXT CH="ni: kule ona li"/>
                <nbspace/>
                <ITEXT CH="sama lili. ona li"/>
                <nbspace/>
                <ITEXT CH="loje, li"/>
                <nbspace/>
                <ITEXT CH="jelo, li"/>
                <nbspace/>
                <ITEXT CH="laso sewi kin. taso a, ona li"/>
                <nbspace/>
                <ITEXT CH="ante lili sama ni: kule ni li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="walo lili a. nasin ni li"/>
                <nbspace/>
                <ITEXT CH="nasin CMYK. nasin ni la, sina pana e"/>
                <nbspace/>
                <ITEXT CH="kule ni tu wan la, sina kama jo e"/>
                <nbspace/>
                <ITEXT CH="pimeja a!"/>
                <para/>
                <ITEXT CH="taso tan ni la, sina wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni kin: nasin kule ante seme li"/>
                <nbspace/>
                <ITEXT CH="lon?"/>
                <para/>
                <ITEXT CH="nanpa tu la, ken la sina sona e"/>
                <nbspace/>
                <ITEXT CH="ni. tenpo pi lili sina la, jan sona li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: sina ken pali e"/>
                <nbspace/>
                <ITEXT CH="kule ale kepeken kule tu wan taso. loje, jelo, laso sewi. sina ken kepeken walo kepeken pimeja kin. taso a, sina ken ala kama jo e"/>
                <nbspace/>
                <ITEXT CH="kule ni luka tan kule ante. sina sitelen kepeken luka sina la, sina sona e"/>
                <nbspace/>
                <ITEXT CH="ni a. ken la ilo sitelen sina li"/>
                <nbspace/>
                <ITEXT CH="ni kin?"/>
                <para/>
                <ITEXT CH="taso a, ilo toki sina li"/>
                <nbspace/>
                <ITEXT CH="kepeken ala e"/>
                <nbspace/>
                <ITEXT CH="ni. ni la, wile sona sin li"/>
                <nbspace/>
                <ITEXT CH="lon: &quot;nasin seme la ilo toki li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kule?&quot;"/>
                <para/>
                <ITEXT CH="o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="sinpin pi ilo toki sina. ona li"/>
                <nbspace/>
                <ITEXT CH="ken pana e"/>
                <nbspace/>
                <ITEXT CH="sitelen tawa lukin sina kepeken kule ale a! ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="suno pi kule ona tan ona. sina lukin e"/>
                <nbspace/>
                <ITEXT CH="ona la, ona li"/>
                <nbspace/>
                <ITEXT CH="ilo suno lili mute. ona li"/>
                <nbspace/>
                <ITEXT CH="loje, li"/>
                <nbspace/>
                <ITEXT CH="laso sewi, li"/>
                <nbspace/>
                <ITEXT CH="laso kasi. ilo li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kule mute a kepeken ni: ona li"/>
                <nbspace/>
                <ITEXT CH="ante e"/>
                <nbspace/>
                <ITEXT CH="wawa pi suno ni. nasin ni li"/>
                <nbspace/>
                <ITEXT CH="nasin RGB. sina wile e"/>
                <nbspace/>
                <ITEXT CH="pimeja la, ilo li"/>
                <nbspace/>
                <ITEXT CH="pana ala e"/>
                <nbspace/>
                <ITEXT CH="wawa tawa ilo suno. walo la, wawa mute tawa ale."/>
                <para/>
                <ITEXT CH="lon la, ilo sitelen mute li"/>
                <nbspace/>
                <ITEXT CH="ni ala. ona li"/>
                <nbspace/>
                <ITEXT CH="wile ala e"/>
                <nbspace/>
                <ITEXT CH="loje tan pimeja tan ni: ona li"/>
                <nbspace/>
                <ITEXT CH="jo kin e"/>
                <nbspace/>
                <ITEXT CH="poki pi telo sitelen pimeja. nasin CMYK li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni a. toki Inli la, sitelen K li"/>
                <nbspace/>
                <ITEXT CH="nimi &quot;Key&quot;, li"/>
                <nbspace/>
                <ITEXT CH="pimeja. taso a, ilo sitelen ale li"/>
                <nbspace/>
                <ITEXT CH="kepeken ni a."/>
                <para/>
                <ITEXT CH="sina ante e"/>
                <nbspace/>
                <ITEXT CH="poki sina pi telo sitelen, li"/>
                <nbspace/>
                <ITEXT CH="kama jo e"/>
                <nbspace/>
                <ITEXT CH="lipu tenpo. wawa a! sina ken lukin e"/>
                <nbspace/>
                <ITEXT CH="toki ni lon lipu. kin la, sina kama sona e"/>
                <nbspace/>
                <ITEXT CH="ni: nasin seme la ilo sitelen li"/>
                <nbspace/>
                <ITEXT CH="sitelen e"/>
                <nbspace/>
                <ITEXT CH="kule? sona ni li"/>
                <nbspace/>
                <ITEXT CH="pona a."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="178.582677165354" YPOS="3376.06299212598" OwnPage="9" ItemID="242874208" PTYPE="4" WIDTH="170.078543307087" HEIGHT="25.511811023622" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Copy of lawa_1 (3)" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 25.5118 L0 25.5118 L0 0 Z" copath="M0 0 L170.079 0 L170.079 25.5118 L0 25.5118 L0 0 Z" gXpos="-55.9055449647736" gYpos="37.1383577052872" gWidth="170.078543307087" gHeight="76.5354330708665" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="tan "/>
                <ITEXT CPARENT="jan pali la nimi" CH="jan Jona"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="sitelen li tan "/>
                <ITEXT CPARENT="jan sitelen la nimi" CH="jan Milese"/>
                <trail PARENT="jan sitelen"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="178.582677165354" YPOS="3316.53543307087" OwnPage="9" ItemID="242922352" PTYPE="4" WIDTH="170.078543307087" HEIGHT="51.0236220472441" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 51.0236 L0 51.0236 L0 0 Z" copath="M0 0 L170.079 0 L170.079 51.0236 L0 51.0236 L0 0 Z" gXpos="-55.9055449647737" gYpos="-22.3892013498312" gWidth="170.078543307087" gHeight="76.5354330708665" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
