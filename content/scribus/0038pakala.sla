            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Regular" FCOLOR="Black" FSHADE="100" CH="ma sina"/>
                <ITEXT FONT="Andika Regular" FCOLOR="Black" CH=" l"/>
                <ITEXT FCOLOR="Black" CH="i lon insa mi kin"/>
                <breakline/>
                <ITEXT FCOLOR="Black" CH="sina ken lukin li ken ala pil"/>
                <ITEXT CH="in"/>
                <breakline/>
                <ITEXT CH="ma powe¹ ni li sama ma ni"/>
                <breakline/>
                <ITEXT CH="taso sina nanpa tu li lon mi"/>
                <para/>
                <ITEXT CH="pakala la jan mute li pilin ike"/>
                <breakline/>
                <ITEXT CH="tan sitelen lon insa mi"/>
                <breakline/>
                <ITEXT CH="taso mi sitelen ala e sitelen powe"/>
                <breakline/>
                <ITEXT CH="lon li ken ike tawa jan ni"/>
                <para/>
                <ITEXT CH="mi pona la sitelen mi li wan"/>
                <breakline/>
                <ITEXT CH="pakala la sitelen li kama mute"/>
                <breakline/>
                <ITEXT CH="jan li pilin monsuta² tan"/>
                <breakline/>
                <ITEXT CH="sike suno luka tu kama ike"/>
                <para/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="¹ "/>
