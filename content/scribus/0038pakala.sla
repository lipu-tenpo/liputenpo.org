        <PAGEOBJECT XPOS="178.582677165354" YPOS="2125.6369674651" OwnPage="5" ItemID="279154448" PTYPE="4" WIDTH="170.078543307087" HEIGHT="425.544134897096" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 425.544 L0 425.544 L0 0 Z" copath="M0 0 L170.079 0 L170.079 425.544 L0 425.544 L0 0 Z" gXpos="598.110236220472" gYpos="821.699959591094" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="283014016" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="o"/>
                <nbspace FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="lon ma."/>
                <ITEXT CH=" o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="kiwen lon ma. o"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="kiwen. ona li"/>
                <nbspace/>
                <ITEXT CH="pona tawa lukin la, sina wile awen e"/>
                <nbspace/>
                <ITEXT CH="ona. taso sina ken ala ken awen e"/>
                <nbspace/>
                <ITEXT CH="ona lon tenpo suli? sina pana e"/>
                <nbspace/>
                <ITEXT CH="ona tawa poki sina la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama ala kama pakala?"/>
                <para/>
                <ITEXT CH="kiwen li"/>
                <nbspace/>
                <ITEXT CH="kiwen - sina wile pakala e"/>
                <nbspace/>
                <ITEXT CH="ona la, ni li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="wawa. taso pakala li"/>
                <nbspace/>
                <ITEXT CH="ken, li"/>
                <nbspace/>
                <ITEXT CH="ken lon kiwen ale a. ni la, sina ken wile sona: kiwen seme li"/>
                <nbspace/>
                <ITEXT CH="wawa a lon kiwen ale? kiwen ante li"/>
                <nbspace/>
                <ITEXT CH="pakala mute la kiwen seme li"/>
                <nbspace/>
                <ITEXT CH="pakala lili?"/>
                <para/>
                <ITEXT CH="a, nasin pakala mute li"/>
                <nbspace/>
                <ITEXT CH="lon la, nasin wawa mute li"/>
                <nbspace/>
                <ITEXT CH="lon."/>
                <para/>
                <ITEXT CH="mi ken pakala e"/>
                <nbspace/>
                <ITEXT CH="kiwen kepeken seli. kiwen li"/>
                <nbspace/>
                <ITEXT CH="awen kiwen lon seli li"/>
                <nbspace/>
                <ITEXT CH="awen wan lon seli wawa la mi ken ala pana e"/>
                <nbspace/>
                <ITEXT CH="seli ale tawa pakala kiwen."/>
                <para/>
                <ITEXT CH="ni la, mi o"/>
                <nbspace/>
                <ITEXT CH="pakala e"/>
                <nbspace/>
                <ITEXT CH="kiwen kepeken kiwen ante. ni la, mi ken sona: kiwen seme li"/>
                <nbspace/>
                <ITEXT CH="awen lon tenpo suli? mi pana e"/>
                <nbspace/>
                <ITEXT CH="kiwen pona wan tawa poki la, kiwen ante kin li"/>
                <nbspace/>
                <ITEXT CH="lon poki la, kiwen seme li"/>
                <nbspace/>
                <ITEXT CH="kama ala pakala?"/>
                <para/>
                <ITEXT CH="mi tawa wawa e"/>
                <nbspace/>
                <ITEXT CH="kiwen wan tawa kiwen ante. kiwen tu la, kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="kama pakala la kiwen pi pakala ala li"/>
                <nbspace/>
                <ITEXT CH="wawa tawa kiwen pakala."/>
                <para/>
                <ITEXT CH="a. taso nasa li"/>
                <nbspace/>
                <ITEXT CH="lon nasin pakala ni. mi pana e"/>
                <nbspace/>
                <ITEXT CH="kiwen wan tawa sike ko wan la ko li"/>
                <nbspace/>
                <ITEXT CH="ken wawa suli li"/>
                <nbspace/>
                <ITEXT CH="kama ala pakala. taso mi wile sona e wawa kiwen, e wawa pi nasin kiwen. kiwen seme li kiwen a."/>
                <para/>
                <ITEXT CH="pona la, nasin ante li lon."/>
                <para/>
                <ITEXT CH="mi kama e kiwen wan lon kiwen ante. mi anpa e kiwen sewi lon selo pi kiwen anpa. kiwen anpa li pakala la, kiwen sewi li wawa tawa kiwen anpa."/>
                <para/>
                <ITEXT CH="mi awen tawa e kiwen lon kiwen ante la mi kama sona e kiwen pi wawa suli lon kiwen ale. kiwen ni li seme?"/>
                <para/>
                <ITEXT CH="ona li ken suwi tawa lukin - taso mi kama jo e ona lon ma la suwi ni li wile e pali: suno li tawa insa ona lon sinpin la, monsi la, kiwen li ken pana sin e suno lon nasin musi. suno walo li ken kama tu anu mute, li tawa poka ante. nasin suno li namako lon ni."/>
                <para/>
                <ITEXT CH="jan li kama ala lukin e kiwen ni lon ma lon tenpo mute. ni la ona li mani."/>
                <para/>
                <ITEXT CH="kiwen ma ante la, kiwen ni li wawa lon ijo tu. wawa nanpa wan la kiwen ni li ken pakala e selo pi kiwen ante. wawa nanpa tu la, seli li kama lon kiwen ni la, kiwen li pana sin e seli kepeken tenpo lili a. jan li wile suli e wawa ni tu la, ona li ken pali e kiwen sin. taso ma la, kiwen wan taso li wawa nanpa wan lon ni tu."/>
                <para/>
                <ITEXT CH="a, taso kin la, o sona e nasin pakala tu lon ona."/>
                <para/>
                <ITEXT CH="nanpa wan la, mi tawa wawa e ilo kiwen tawa kiwen ni pi wawa suli la, ona li pakala. kiwen li tawa lon selo pi kiwen wawa la, ona li pakala ala. taso ilo mi li tawa wawa la kiwen li kama pakala."/>
                <para/>
                <ITEXT CH="nanpa tu la, kiwen wawa li tawa lon kiwen pi wawa sama la, kiwen ni tu li ken pakala."/>
                <para/>
                <ITEXT CH="wawa kiwen li awen ala e kiwen wawa."/>
                <para/>
                <ITEXT CH="o lon ma. o jo e kiwen tan ma. kiwen o pona tawa lukin sina. sina wile ala pakala e ona la - a, sina wile ala pakala e ona la, o pana e kiwen wan taso tawa poki sina."/>
                <para/>
            </StoryText>
