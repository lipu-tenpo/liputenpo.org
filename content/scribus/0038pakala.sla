                <DefaultStyle/>
                <ITEXT CH="tan"/>
                <ITEXT CPARENT="jan pali la nimi" CH=" jan Alon"/>
                <trail PARENT="jan pali"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="1468.62992125984" OwnPage="4" ItemID="279462000" PTYPE="4" WIDTH="170.078543307087" HEIGHT="70.8661417322819" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 70.8661 L0 70.8661 L0 0 Z" copath="M0 0 L170.079 0 L170.079 70.8661 L0 70.8661 L0 0 Z" gXpos="311.810728346457" gYpos="-1266.15728097279" gWidth="170.078543307087" gHeight="76.5354330708665" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FCOLOR="laso pimeja" FSHADE="100" CH="sona pi ijo kiwen lili li pona"/>
                <trail PARENT="lawa" ALIGN="0"/>
            </StoryText>
