        <PAGEOBJECT XPOS="589.606330708661" YPOS="4045.03937007874" OwnPage="12" ItemID="978386870" PTYPE="4" WIDTH="139.953136565275" HEIGHT="143.114920761486" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L139.953 0 L139.953 143.115 L0 143.115 L0 0 Z" copath="M0 0 L139.953 0 L139.953 143.115 L0 143.115 L0 0 Z" gXpos="170.078771653543" gYpos="6000.94488188976" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="978444022" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text148_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="o"/>
                <nbspace CPARENT="Text148_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text148_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="kama sona e"/>
                <nbspace CPARENT="Text148_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text148_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ma sin"/>
                <ITEXT CH=" lon poka sina! musi ni la tenpo suno ale la ilo li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="sona ma. sina o"/>
                <nbspace/>
                <ITEXT CH="tawa ma ni. ni li"/>
                <nbspace/>
                <ITEXT CH="musi pi alasa ma."/>
                <para/>
                <ITEXT CPARENT="Text148_Bold" CH="sona ma li"/>
                <nbspace CPARENT="Text148_Bold"/>
                <ITEXT CPARENT="Text148_Bold" CH="kama tan seme?"/>
                <para/>
                <ITEXT CH="musi ni li"/>
                <nbspace/>
                <ITEXT CH="kama lon tan sitelen Ekesite (XKCD) nanpa TTAMLW¹. sitelen li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="nasin ilo:"/>
                <para/>
                <ITEXT CH="ilo li"/>
                <nbspace/>
                <ITEXT CH="kepeken nanpa open pi tomo mani lon ma tomo Nujo. tenpo suno ale la nanpa pi tomo mani li"/>
                <nbspace/>
                <ITEXT CH="ante mute. ni la jan ala li"/>
                <nbspace/>
                <ITEXT CH="ken sona e"/>
                <nbspace/>
                <ITEXT CH="nanpa pi tenpo kama suli. ona li"/>
                <nbspace/>
                <ITEXT CH="ken sona e"/>
                <nbspace/>
                <ITEXT CH="nanpa pi tenpo suno wan taso."/>
                <para/>
                <ITEXT CH="ilo li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="nanpa ni li"/>
                <nbspace/>
                <ITEXT CH="ante e"/>
                <nbspace/>
                <ITEXT CH="ona tawa nanpa pi linja ma."/>
                <para/>
                <ITEXT CH="nanpa pi linja ma li"/>
                <nbspace/>
                <ITEXT CH="seme? linja suli li"/>
                <nbspace/>
                <ITEXT CH="kipisi e"/>
                <nbspace/>
                <ITEXT CH="ma ale. nasin linja tu li"/>
                <nbspace/>
                <ITEXT CH="lon: linja wan li"/>
                <nbspace/>
                <ITEXT CH="sike. ma lete li"/>
                <nbspace/>
                <ITEXT CH="lon insa sike. sike li"/>
                <nbspace/>
                <ITEXT CH="lili lon poka pi ma lete li"/>
                <nbspace/>
                <ITEXT CH="suli lon ma seli. linja ante li"/>
                <nbspace/>
                <ITEXT CH="tan ma lete wan tawa ma lete ante. tenpo la sina wile pana e"/>
                <nbspace/>
                <ITEXT CH="sona ni tawa jan ante: ma lili wan li"/>
                <nbspace/>
                <ITEXT CH="lon seme? kepeken nanpa linja la jan ale li"/>
                <nbspace/>
                <ITEXT CH="ken sona."/>
                <para/>
                <ITEXT CH="musi ni la nanpa mute pi linja ma li"/>
                <nbspace/>
                <ITEXT CH="kama lon. jan ale li"/>
                <nbspace/>
                <ITEXT CH="ken tawa ma lili lon poka ona tan ni."/>
                <para/>
                <ITEXT CPARENT="Text148_Bold" CH="mi wile musi la mi o"/>
                <nbspace CPARENT="Text148_Bold"/>
                <ITEXT CPARENT="Text148_Bold" CH="seme?"/>
                <para/>
                <ITEXT CH="ilo li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="sona ma la sina o"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="ma ni o"/>
                <nbspace/>
                <ITEXT CH="tawa ona. tenpo mute la ma ni li"/>
                <nbspace/>
                <ITEXT CH="sin tawa sina. ni la sina ken pona e"/>
                <nbspace/>
                <ITEXT CH="sona sina pi ma"/>
                <nbspace/>
                <ITEXT CH="poka!"/>
                <para/>
                <ITEXT CH="sina kama tawa ma pona la jan ante kin li"/>
                <nbspace/>
                <ITEXT CH="ken lon. ni la sina ken kama sona e"/>
                <nbspace/>
                <ITEXT CH="jan ante pi musi ni. kulupu li"/>
                <nbspace/>
                <ITEXT CH="pona"/>
                <nbspace/>
                <ITEXT CH="a!"/>
                <para/>
                <ITEXT CH="tenpo alasa li"/>
                <nbspace/>
                <ITEXT CH="pini la sina ken toki e"/>
                <nbspace/>
                <ITEXT CH="tawa sina lon lipu kulupu². jan li"/>
                <nbspace/>
                <ITEXT CH="ken lukin e"/>
                <nbspace/>
                <ITEXT CH="toki tawa pi jan ante lon lipu ni."/>
                <para/>
                <ITEXT CH="kin la sina ken kama jo e"/>
                <nbspace/>
                <ITEXT CH="lipu lili. ona li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="pali pona sina. alasa ma la musi mute li"/>
                <nbspace/>
                <ITEXT CH="ken lon. ken la sina tawa lon telo. ken la sina alasa e"/>
                <nbspace/>
                <ITEXT CH="ma lon tenpo pimeja anu lon open pi tenpo suno sin. sina lon ma pona la ken la sina pali e"/>
                <nbspace/>
                <ITEXT CH="sitelen, anu sina jo e"/>
                <nbspace/>
                <ITEXT CH="len musi, anu sina pali e"/>
                <nbspace/>
                <ITEXT CH="jan pi ko lete. ni ale en ante mute la sina kama jo e"/>
                <nbspace/>
                <ITEXT CH="lipu lili tan kulupu. lipu li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: &quot;jan ni li"/>
                <nbspace/>
                <ITEXT CH="[pali e"/>
                <nbspace/>
                <ITEXT CH="ijo musi X] lon alasa ma pi tenpo suno Y.&quot;"/>
                <para/>
                <ITEXT CH="o"/>
                <nbspace/>
                <ITEXT CH="musi pona!"/>
                <para/>
                <ITEXT CH="¹ https://xkcd.com/426/"/>
                <breakline/>
                <ITEXT CH="² https://geohashing.site/"/>
                <para PARENT="toki lili poka"/>
            </StoryText>
        </PAGEOBJECT>
