        <PAGEOBJECT XPOS="362.834645669291" YPOS="4620.70397687631" OwnPage="13" ItemID="975345350" PTYPE="4" WIDTH="170.078543307087" HEIGHT="51.0236220472441" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 51.0236 L0 51.0236 L0 0 Z" copath="M0 0 L170.079 0 L170.079 51.0236 L0 51.0236 L0 0 Z" gXpos="-267.243695803848" gYpos="-70.007874015748" gWidth="170.078543307087" gHeight="76.5354330708665" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
