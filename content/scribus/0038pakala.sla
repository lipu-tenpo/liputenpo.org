                <ITEXT CPARENT="Text81_Bold" FONTSIZE="8.5" FCOLOR="loje pimeja" FSHADE="100" CH="pakala ale ala li"/>
                <nbspace CPARENT="Text81_Bold" FONTSIZE="8.5" FCOLOR="loje pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text81_Bold" FONTSIZE="8.5" FCOLOR="loje pimeja" FSHADE="100" CH="ike."/>
                <ITEXT FONTSIZE="8.5" CH=" jan li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pakala la, pali kama ona li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="ken pona anu ike e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pakala ni. pakala pona li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="wile e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="ni tu wan: pakala la, jan li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="sona, li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pona, li"/>
