        <PAGEOBJECT XPOS="178.582677165354" YPOS="3626.67716535434" OwnPage="9" ItemID="277546576" PTYPE="4" WIDTH="170.078543307087" HEIGHT="228.440944881884" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 228.441 L0 228.441 L0 0 Z" copath="M0 0 L170.079 0 L170.079 228.441 L0 228.441 L0 0 Z" gXpos="598.110236220472" gYpos="2974.70866141733" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="277535248" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text83_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="jan Enwi Aka Wali"/>
                <ITEXT CH="¹ li"/>
                <nbspace/>
                <ITEXT CH="jan pi tenpo majuna² pi ma Juwese. mama li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="ona lon ma lili Ajowa. kulupu ona li"/>
                <nbspace/>
                <ITEXT CH="mama e"/>
                <nbspace/>
                <ITEXT CH="kili li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="lipu. lipu ni li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="kili. jan Enwi li"/>
                <nbspace/>
                <ITEXT CH="olin e"/>
                <nbspace/>
                <ITEXT CH="kasi e"/>
                <nbspace/>
                <ITEXT CH="kili. jan So Wasinton Kawa³ li"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="kasi mute li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="sona tawa jan sin Enwi. jan Enwi li"/>
                <nbspace/>
                <ITEXT CH="tawa tomo sona suli li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="sona pi kili jelo. kili moku ni li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="nena lili mute li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="selo laso pi moku ala. ijo mute li"/>
                <nbspace/>
                <ITEXT CH="pona tawa ona. ona li"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="kili e"/>
                <nbspace/>
                <ITEXT CH="nimi e"/>
                <nbspace/>
                <ITEXT CH="nanpa e"/>
                <nbspace/>
                <ITEXT CH="mani e"/>
                <nbspace/>
