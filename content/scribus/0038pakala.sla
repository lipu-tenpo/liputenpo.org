                <ITEXT CH="toki pona lon ma kasi lili. mi pilin pona tan ni: mi sona e"/>
                <nbspace/>
                <ITEXT CH="jan ale tan tenpo kulupu pini li"/>
                <nbspace/>
                <ITEXT CH="kulupu sin lon poka ona. tenpo pimeja la mi musi kepeken lipu musi li"/>
                <nbspace/>
                <ITEXT CH="toki mute."/>
                <para/>
                <ITEXT CH="kin la mi mute li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ma tomo Aken. jan Alonola li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ijo suli ona. ma tomo Aken li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="tomo sewi suli e"/>
                <nbspace/>
                <ITEXT CH="open telo nasa. open telo li"/>
                <nbspace/>
                <ITEXT CH="pona tawa sijelo. taso ona li"/>
                <nbspace/>
                <ITEXT CH="ike a tawa pilin nena. tenpo ante la mi tawa ma pi ma tu wan kepeken ilo. ma Netelan en ma Pesike en ma Tosi li"/>
                <nbspace/>
                <ITEXT CH="lon poka ni. mi lukin e ma ni li"/>
                <nbspace/>
                <ITEXT CH="tawa lon ma kasi ona."/>
                <para/>
                <ITEXT CH="tenpo lawa la mi mute li"/>
                <nbspace/>
                <ITEXT CH="kulupu lon poka pi jan ante pi lipu tenpo li"/>
                <nbspace/>
                <ITEXT CH="toki e lawa ona. mi pana e sona sin li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="pilin e"/>
                <nbspace/>
                <ITEXT CH="pali pi tenpo kama. jan mute li"/>
                <nbspace/>
                <ITEXT CH="wile pali e"/>
                <nbspace/>
                <ITEXT CH="ijo sin. pini la jan Alonola li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="lipu tenpo mute ona tawa jan ale. tenpo ni la jan lon ma mute li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="lipu tenpo mute lon tomo ona."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
