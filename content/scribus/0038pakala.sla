                <ITEXT FCOLOR="unu pimeja" FSHADE="100" CH="seme li mi"/>
                <trail PARENT="lawa" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="5026.60717410324" OwnPage="14" ItemID="277360736" PTYPE="4" WIDTH="170.078543307087" HEIGHT="132.447944007" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 132.448 L0 132.448 L0 0 Z" copath="M0 0 L170.079 0 L170.079 132.448 L0 132.448 L0 0 Z" gXpos="589.606299212598" gYpos="2418.73315835521" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="277377728" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Bold" FCOLOR="unu pimeja" FSHADE="100" CH="ma sina"/>
                <ITEXT CH=" li lon insa mi kin"/>
                <breakline/>
                <ITEXT CH="sina ken lukin li ken ala pilin"/>
                <breakline/>
                <ITEXT CH="ma powe¹ ni li sama ma ni"/>
                <breakline/>
                <ITEXT CH="taso sina nanpa tu li lon mi"/>
                <para/>
                <ITEXT CH="pakala la jan mute li pilin ike"/>
                <breakline/>
                <ITEXT CH="tan sitelen lon insa mi"/>
                <breakline/>
                <ITEXT CH="taso mi sitelen ala e sitelen powe"/>
                <breakline/>
                <ITEXT CH="lon li ken ike tawa jan ni"/>
                <para/>
                <ITEXT CH="mi pona la sitelen mi li wan"/>
                <breakline/>
                <ITEXT CH="pakala la sitelen li kama mute"/>
                <breakline/>
                <ITEXT CH="jan li pilin monsuta² tan"/>
                <breakline/>
                <ITEXT CH="sike suno luka tu kama ike"/>
                <para/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="¹  "/>
                <ITEXT CPARENT="Text125_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="powe"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH=" li sama "/>
                <ITEXT CPARENT="Text125_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="lon ala"/>
                <para PARENT="toki lili poka"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="²  jan li pilin "/>
                <ITEXT CPARENT="Text125_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="monsuta"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH=" la ona li pilin "/>
                <ITEXT CPARENT="Text125_Italic" FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH="ike"/>
                <ITEXT FONTSIZE="7.1" FCOLOR="kapesi pi toki lili" FSHADE="100" CH=" tan ike kama"/>
                <para PARENT="toki lili poka"/>
            </StoryText>
        </PAGEOBJECT>
