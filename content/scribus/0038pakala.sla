        <PAGEOBJECT XPOS="177.830511811023" YPOS="3672.77982657231" OwnPage="9" ItemID="985472299" PTYPE="4" WIDTH="170.078543307087" HEIGHT="176.668992325329" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 176.669 L0 176.669 L0 0 Z" copath="M0 0 L170.079 0 L170.079 176.669 L0 176.669 L0 0 Z" gXpos="597.358070866141" gYpos="3020.8113226353" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="987600843" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text74_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="tenpo pini majuna la, ma li"/>
                <nbspace CPARENT="Text74_Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text74_Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ante mute."/>
                <ITEXT CH=" monsuta lili en monsuta suli li"/>
                <nbspace/>
                <ITEXT CH="lon. ona li"/>
                <nbspace/>
                <ITEXT CH="soweli ala, li"/>
                <nbspace/>
                <ITEXT CH="akesi ala, li"/>
                <nbspace/>
                <ITEXT CH="waso ala. taso ona li"/>
                <nbspace/>
                <ITEXT CH="sama ni ale: ona li"/>
                <nbspace/>
                <ITEXT CH="tawa li"/>
                <nbspace/>
                <ITEXT CH="moku li"/>
                <nbspace/>
                <ITEXT CH="unpa li"/>
                <nbspace/>
                <ITEXT CH="mama sama waso, sama akesi, sama soweli. sina ken toki e"/>
                <nbspace/>
                <ITEXT CH="ni: lon tenpo pi suli mute la, monsuta ni li"/>
                <nbspace/>
                <ITEXT CH="lawa e"/>
                <nbspace/>
                <ITEXT CH="ma."/>
                <para/>
                <ITEXT CH="tenpo wan la, mun suli li"/>
                <nbspace/>
                <ITEXT CH="kama ma kepeken wawa wawa, kepeken tenpo lili taso. ona li"/>
                <nbspace/>
                <ITEXT CH="pakala mute mute e"/>
                <nbspace/>
                <ITEXT CH="ijo ale, li"/>
                <nbspace/>
                <ITEXT CH="moli"/>
                <nbspace/>
                <ITEXT CH="a e"/>
                <nbspace/>
                <ITEXT CH="monsuta majuna ni. lawa pi monsuta majuna li"/>
                <nbspace/>
                <ITEXT CH="pini."/>
                <para/>
                <ITEXT CH="ken suli la, sina sona e"/>
                <nbspace/>
                <ITEXT CH="ni ale, li"/>
                <nbspace/>
                <ITEXT CH="sona kin e"/>
                <nbspace/>
                <ITEXT CH="ni: tenpo lawa pi monsuta majuna la, soweli li"/>
                <nbspace/>
                <ITEXT CH="lon, taso soweli li"/>
                <nbspace/>
                <ITEXT CH="lili, li"/>
                <nbspace/>
                <ITEXT CH="sama"/>
                <nbspace/>
                <ITEXT CH="a tawa soweli ante. tenpo pi pakala mun la, soweli li"/>
                <nbspace/>
                <ITEXT CH="kama mute, li"/>
                <nbspace/>
                <ITEXT CH="kama suli, li"/>
                <nbspace/>
                <ITEXT CH="kama jo e"/>
                <nbspace/>
                <ITEXT CH="wawa pi ante mute. tenpo ni la, soweli li"/>
                <nbspace/>
                <ITEXT CH="lon ale, li"/>
                <nbspace/>
                <ITEXT CH="awen pona lon ma ona kepeken wawa ni. tenpo ni la, sina lukin e"/>
                <nbspace/>
                <ITEXT CH="soweli tu la, sina ken lukin e"/>
                <nbspace/>
                <ITEXT CH="ni: soweli nanpa wan en soweli nanpa tu li"/>
                <nbspace/>
                <ITEXT CH="ante mute"/>
                <nbspace/>
                <ITEXT CH="a! soweli li"/>
                <nbspace/>
                <ITEXT CH="ken kala, li"/>
                <nbspace/>
                <ITEXT CH="ken waso, li"/>
                <nbspace/>
                <ITEXT CH="ken akesi kin."/>
                <para/>
                <ITEXT CH="tan seme la, soweli li"/>
                <nbspace/>
                <ITEXT CH="kama suli?"/>
                <para/>
                <ITEXT CH="jan li"/>
                <nbspace/>
                <ITEXT CH="sona pi ale ala e"/>
                <nbspace/>
                <ITEXT CH="tan ni, taso ona li"/>
                <nbspace/>
                <ITEXT CH="ken alasa e"/>
                <nbspace/>
                <ITEXT CH="sona sin. tenpo pini lili la, jan sona li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="sona ken sin pi kama suli soweli. ona li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: soweli li"/>
                <nbspace/>
                <ITEXT CH="kama suli la, soko li"/>
                <nbspace/>
                <ITEXT CH="suli"/>
                <nbspace/>
                <ITEXT CH="a!"/>
                <para/>
                <ITEXT CH="tan seme la, soko li"/>
                <nbspace/>
                <ITEXT CH="suli tawa kama suli soweli? ma li"/>
                <nbspace/>
                <ITEXT CH="sama seme lon tenpo pi pakala mun? nasin seme la, soweli li"/>
                <nbspace/>
                <ITEXT CH="kama lawa lon ma?"/>
                <para/>
                <ITEXT CH="mun pakala li"/>
                <nbspace/>
                <ITEXT CH="kama ma la, ona li"/>
                <nbspace/>
                <ITEXT CH="anpa e"/>
                <nbspace/>
                <ITEXT CH="ken awen pi ijo mute. ona li"/>
                <nbspace/>
                <ITEXT CH="suli"/>
                <nbspace/>
                <ITEXT CH="a, li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kipisi lili ma mute tawa ale sewi. kipisi lili ni li"/>
                <nbspace/>
                <ITEXT CH="kama kon jaki pi walo pimeja, li"/>
                <nbspace/>
                <ITEXT CH="selo e"/>
                <nbspace/>
                <ITEXT CH="ma tan suno. moli li"/>
                <nbspace/>
                <ITEXT CH="lon ale."/>
                <para/>
                <ITEXT CH="soko en moli li"/>
                <nbspace/>
                <ITEXT CH="pona tawa ona ante. ni la, soko li"/>
                <nbspace/>
                <ITEXT CH="kama suli lon ma ale. ona li"/>
                <nbspace/>
                <ITEXT CH="moku pi tenpo suli e"/>
                <nbspace/>
                <ITEXT CH="sijelo pi monsuta moli, li"/>
                <nbspace/>
                <ITEXT CH="len e"/>
                <nbspace/>
                <ITEXT CH="ma tan moku ni. ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="lili mama ona tawa kon. lili ni li"/>
                <nbspace/>
                <ITEXT CH="jaki mute, li"/>
                <nbspace/>
                <ITEXT CH="kama lon insa sijelo pi monsuta majuna. sijelo pi monsuta majuna li"/>
                <nbspace/>
                <ITEXT CH="ken ala awen lon ni: jaki soko li"/>
                <nbspace/>
                <ITEXT CH="awen lon. sijelo li"/>
                <nbspace/>
                <ITEXT CH="moli, li"/>
                <nbspace/>
                <ITEXT CH="kama moku tawa soko ante"/>
                <nbspace/>
                <ITEXT CH="a."/>
                <para/>
                <ITEXT CH="taso sijelo pi monsuta majuna en sijelo soweli li"/>
                <nbspace/>
                <ITEXT CH="ante, li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="ilo ante, li"/>
                <nbspace/>
                <ITEXT CH="kepeken nasin ante tawa wile sama. pakala kama la ante li"/>
                <nbspace/>
                <ITEXT CH="ken suli"/>
                <nbspace/>
                <ITEXT CH="a tawa toki alasa ni: seme li"/>
                <nbspace/>
                <ITEXT CH="moli? seme li"/>
                <nbspace/>
                <ITEXT CH="moli ala?"/>
                <para/>
                <ITEXT CH="nanpa wan la, soweli mute pi tenpo majuna li"/>
                <nbspace/>
                <ITEXT CH="lili, li"/>
                <nbspace/>
                <ITEXT CH="awen mute lon anpa ma. pakala mun li"/>
                <nbspace/>
                <ITEXT CH="ante lili e"/>
                <nbspace/>
                <ITEXT CH="ma pi anpa ma; ma pi supa ma li"/>
                <nbspace/>
                <ITEXT CH="kama lete, li"/>
                <nbspace/>
                <ITEXT CH="kama pimeja, li"/>
                <nbspace/>
                <ITEXT CH="kama weka tan kasi. ma pi anpa ma li"/>
                <nbspace/>
                <ITEXT CH="lete, li"/>
                <nbspace/>
                <ITEXT CH="pimeja, li"/>
                <nbspace/>
                <ITEXT CH="jo ala e"/>
                <nbspace/>
                <ITEXT CH="kasi lon ale. soweli pi anpa ma li"/>
                <nbspace/>
                <ITEXT CH="ken awen lon ni tan tenpo pini. anpa ma la, sijelo soweli li"/>
                <nbspace/>
                <ITEXT CH="ken awen pona. ma pi supa ma li"/>
                <nbspace/>
                <ITEXT CH="kama sama ma pi anpa ma la, soweli li"/>
                <nbspace/>
                <ITEXT CH="tawa supa, li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="tomo ona sin lon supa. tan ni la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama ante tan ona ante."/>
                <para/>
                <ITEXT CH="nanpa tu la, soweli li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="sijelo seli. (monsuta majuna kin li"/>
                <nbspace/>
                <ITEXT CH="seli e"/>
                <nbspace/>
                <ITEXT CH="sijelo ona, taso seli tu ni la, soweli li"/>
                <nbspace/>
                <ITEXT CH="seli nanpa wan). sijelo soweli li"/>
                <nbspace/>
                <ITEXT CH="ilo e"/>
                <nbspace/>
                <ITEXT CH="seli ona tawa utala jaki. seli soweli li"/>
                <nbspace/>
                <ITEXT CH="pakala e"/>
                <nbspace/>
                <ITEXT CH="awen pi jaki soko lon sijelo ona!"/>
                <para/>
                <ITEXT CH="nanpa tu wan la, soweli en monsuta majuna li"/>
                <nbspace/>
                <ITEXT CH="moku e"/>
                <nbspace/>
                <ITEXT CH="kon pona li"/>
                <nbspace/>
                <ITEXT CH="weka e"/>
                <nbspace/>
                <ITEXT CH="kon jaki. ona tu li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="ilo kon tawa ni, taso ilo tu li"/>
                <nbspace/>
                <ITEXT CH="ante. moku kon en weka kon la, ilo kon monsuta li"/>
                <nbspace/>
                <ITEXT CH="pona namako tawa ni: monsuta li"/>
                <nbspace/>
                <ITEXT CH="tawa kepeken kon lili. ante la, soweli li"/>
                <nbspace/>
                <ITEXT CH="moku e"/>
                <nbspace/>
                <ITEXT CH="kon mute tawa ijo sama."/>
                <para/>
                <ITEXT CH="ni li"/>
                <nbspace/>
                <ITEXT CH="pona tawa monsuta majuna. tan ni la, monsuta majuna pi ale ala li"/>
                <nbspace/>
                <ITEXT CH="moli. monsuta pi moli ala li"/>
                <nbspace/>
                <ITEXT CH="kama waso!"/>
                <para/>
                <ITEXT CH="taso ilo kon pona li"/>
                <nbspace/>
                <ITEXT CH="ken ike kin. ilo kon pi monsuta majuna li"/>
                <nbspace/>
                <ITEXT CH="pona"/>
                <nbspace/>
                <ITEXT CH="a, li"/>
                <nbspace/>
                <ITEXT CH="kama e"/>
                <nbspace/>
                <ITEXT CH="kon pona tan kon ale tawa ale pi sijelo ona kepeken pali lili. taso, jaki soko li"/>
                <nbspace/>
                <ITEXT CH="lon kon ale la, monsuta majuna li"/>
                <nbspace/>
                <ITEXT CH="kama e"/>
                <nbspace/>
                <ITEXT CH="jaki soko lon ale sijelo kepeken pali lili kin! ona li"/>
                <nbspace/>
                <ITEXT CH="wile utala e"/>
                <nbspace/>
                <ITEXT CH="jaki ni la, utala li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="pali mute"/>
                <nbspace/>
                <ITEXT CH="a. ilo kon soweli li"/>
                <nbspace/>
                <ITEXT CH="ike lili tawa esun kon, taso ona li"/>
                <nbspace/>
                <ITEXT CH="awen pona e"/>
                <nbspace/>
                <ITEXT CH="sijelo tan jaki! soweli li"/>
                <nbspace/>
                <ITEXT CH="ken utala e"/>
                <nbspace/>
                <ITEXT CH="jaki soko kepeken pali lili"/>
                <nbspace/>
                <ITEXT CH="a."/>
                <para/>
                <ITEXT CH="ale la, ma pi pakala mun li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="ken ni tawa soweli: o"/>
                <nbspace/>
                <ITEXT CH="kama lawa e"/>
                <nbspace/>
                <ITEXT CH="ma pi open sin!"/>
                <para/>
                <ITEXT FONT="Andika Bold" CH="lipu tan:"/>
                <breakline/>
                <ITEXT CH="https://pmc.ncbi.nlm.nih.gov/articles/PMC7365386/ (toki Inli)"/>
                <breakline/>
                <ITEXT CH="https://journals.asm.org/doi/full/10.1128/mbio.00521-26 (toki Inli)"/>
                <para PARENT="toki lili poka"/>
            </StoryText>
        </PAGEOBJECT>
