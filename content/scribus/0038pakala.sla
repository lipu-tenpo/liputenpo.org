        <PAGEOBJECT XPOS="215.360385940737" YPOS="5356.19622047244" OwnPage="15" ItemID="965746934" PTYPE="4" WIDTH="276.915902308042" HEIGHT="257.271386275384" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="14.1732283464567" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L276.916 0 L276.916 257.271 L0 257.271 L0 0 Z" copath="M0 0 L276.916 0 L276.916 257.271 L0 257.271 L0 0 Z" gXpos="215.360385940739" gYpos="4720.92094488189" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CPARENT="toki wawa" FCOLOR="laso pimeja" CH="Hello!"/>
                <ITEXT FCOLOR="laso pimeja" CH=" "/>
                <ITEXT CH="You’re looking at "/>
                <ITEXT FONT="Andika Italic" CH="lipu tenpo"/>
                <ITEXT CH=","/>
                <nbspace/>
                <ITEXT CH="a magazine written in Toki Pona."/>
                <breakline/>
                <ITEXT CH="Maybe you’re new and want to know more about this lan­­guage. Great!"/>
                <breakline/>
                <ITEXT CH="This page hopes to answer some of your questions."/>
                <para/>
                <ITEXT CH="What is Toki Pona?"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="Toki Pona is a fun minimal constructed lan­­guage, created in 2001."/>
                <breakline/>
                <ITEXT CH="It has only got 14 letters and about 130 words."/>
                <para/>
                <ITEXT CH="Why would I learn Toki Pona?"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="Despite how tiny the language is, it is still possible to describe any"/>
                <breakline/>
                <ITEXT CH="concept with it. This might fascinate you. Maybe you just want to take"/>
                <breakline/>
                <ITEXT CH="a break from the complex world we live in. Or perhaps you just want"/>
                <breakline/>
                <ITEXT CH="to talk to your friends without others knowing what you’re saying."/>
                <para/>
                <ITEXT CH="How can I learn Toki Pona, and where can I use it?"/>
                <para PARENT="jan pali"/>
                <ITEXT CH="There are several free courses, of which "/>
                <ITEXT FONT="Andika Italic" CH="Wasona"/>
                <ITEXT CH=" is the most popular. It’s available in 14 languages on "/>
                <ITEXT CPARENT="toki wawa" FCOLOR="laso pimeja" CH="wasona.com"/>
                <ITEXT CH=". More resources, as well as Toki Pona communities and content, can be found on "/>
                <ITEXT CPARENT="toki wawa" FCOLOR="laso pimeja" CH="tokipona.net"/>
                <ITEXT CH=", the community website. Finally, you can read all previous editions of "/>
                <ITEXT FONT="Andika Italic" CH="lipu tenpo"/>
                <ITEXT CH=" for free on our own website: "/>
                <ITEXT CPARENT="toki wawa" FCOLOR="laso pimeja" CH="liputenpo.org"/>
                <ITEXT CH="."/>
                <trail/>
