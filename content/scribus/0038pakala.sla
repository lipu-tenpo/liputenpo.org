        <PAGEOBJECT XPOS="178.582933202275" YPOS="4072.92763879198" OwnPage="11" ItemID="967758102" PTYPE="4" WIDTH="170.078350262292" HEIGHT="406.11492076149" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.078 0 L170.078 406.115 L0 406.115 L0 0 Z" copath="M0 0 L170.078 0 L170.078 406.115 L0 406.115 L0 0 Z" gXpos="178.582933202275" gYpos="4072.92763879198" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="968023974" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="0" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="kon li"/>
                <nbspace FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="lete la,"/>
                <ITEXT CH=" pali mute li"/>
                <nbspace/>
                <ITEXT CH="ken ala. kasi li"/>
                <nbspace/>
                <ITEXT CH="kama pana ala e"/>
                <nbspace/>
                <ITEXT CH="pan e"/>
                <nbspace/>
                <ITEXT CH="kili. kili li"/>
                <nbspace/>
                <ITEXT CH="alasa tawa ma lete la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama ala kasi sin. jan li"/>
                <nbspace/>
                <ITEXT CH="wile tawa kepeken noka la, noka li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="wawa pi mute ike tan ko lete mute. kulupu li"/>
                <nbspace/>
                <ITEXT CH="lili e"/>
                <nbspace/>
                <ITEXT CH="pali tan tenpo lete. pali ala la jan o"/>
                <nbspace/>
                <ITEXT CH="seme? jan o"/>
                <nbspace/>
                <ITEXT CH="musi a. ma lete mute la musi li"/>
                <nbspace/>
                <ITEXT CH="lon. ken la kulupu li"/>
                <nbspace/>
                <ITEXT CH="tawa lon poka, li"/>
                <nbspace/>
                <ITEXT CH="kalama. ken la kulupu li"/>
                <nbspace/>
                <ITEXT CH="open e"/>
                <nbspace/>
                <ITEXT CH="kasi suli, li"/>
                <nbspace/>
                <ITEXT CH="namako suwi e"/>
                <nbspace/>
                <ITEXT CH="ona. ken la jan suli li"/>
                <nbspace/>
                <ITEXT CH="pana suwi e"/>
                <nbspace/>
                <ITEXT CH="ijo tawa jan lili."/>
                <para LINESPMode="0"/>
                <ITEXT CH="tenpo lete musi li"/>
                <nbspace/>
                <ITEXT CH="kama lon ma Sensa lon ma lili Jele la, soweli li"/>
                <nbspace/>
                <ITEXT CH="kama lon. nimi soweli en nimi ma li"/>
                <nbspace/>
                <ITEXT CH="sama. ona li"/>
                <nbspace/>
                <ITEXT CH="soweli Jele. soweli li"/>
                <nbspace/>
                <ITEXT CH="suli a sama tomo. lawa soweli la palisa tu li"/>
                <nbspace/>
                <ITEXT CH="lon, li"/>
                <nbspace/>
                <ITEXT CH="suli sama lupa tomo. taso soweli ni li"/>
                <nbspace/>
                <ITEXT CH="moku ala, li"/>
                <nbspace/>
                <ITEXT CH="lape ala, li"/>
                <nbspace/>
                <ITEXT CH="tawa ala a. ona li"/>
                <nbspace/>
                <ITEXT CH="sama soweli tawa lukin taso. insa ona li"/>
                <nbspace/>
                <ITEXT CH="insa soweli ala, li"/>
                <nbspace/>
                <ITEXT CH="ko kasi a."/>
                <para LINESPMode="0"/>
                <ITEXT CH="tenpo sike ale la, kulupu li"/>
                <nbspace/>
                <ITEXT CH="kepeken ko kasi, li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="soweli suli. soweli pi ko kasi li"/>
                <nbspace/>
                <ITEXT CH="musi e"/>
                <nbspace/>
                <ITEXT CH="pilin kulupu. soweli ni o"/>
                <nbspace/>
                <ITEXT CH="awen lon ale pi tenpo musi lete. taso sike mute la soweli li"/>
                <nbspace/>
                <ITEXT CH="awen ala a. ijo li"/>
                <nbspace/>
                <ITEXT CH="pakala wawa e"/>
                <nbspace/>
                <ITEXT CH="soweli."/>
                <para LINESPMode="0"/>
                <ITEXT CH="ko kasi li"/>
                <nbspace/>
                <ITEXT CH="jelo. telo mute li"/>
                <nbspace/>
                <ITEXT CH="weka tan ona. ko li"/>
                <nbspace/>
                <ITEXT CH="kama ken seli wawa. sike open la jan wan li"/>
                <nbspace/>
                <ITEXT CH="seli e"/>
                <nbspace/>
                <ITEXT CH="ko. seli li"/>
                <nbspace/>
                <ITEXT CH="moku wawa e"/>
                <nbspace/>
                <ITEXT CH="sijelo soweli. kulupu li"/>
                <nbspace/>
                <ITEXT CH="ken ala pini e"/>
                <nbspace/>
                <ITEXT CH="seli, li"/>
                <nbspace/>
                <ITEXT CH="ken ala awen e"/>
                <nbspace/>
                <ITEXT CH="soweli. lawa ma li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="seli, li"/>
                <nbspace/>
                <ITEXT CH="utala e"/>
                <nbspace/>
                <ITEXT CH="jan pakala."/>
                <para LINESPMode="0"/>
                <ITEXT CH="seli wan li"/>
                <nbspace/>
                <ITEXT CH="musi lili. musi suli li"/>
                <nbspace/>
                <ITEXT CH="ni: seli li awen kama. sike #TT la seli kin li pakala e soweli. sike #MT la kulupu li lili e ken seli kepeken telo pona. awen la soweli li seli. sike #MLT la kulupu li pali e soweli tu a. ona tu li seli sama. sike #MLLTT la soweli li kama lon li kama seli lon suno sama a. sike #MMLLW la jan Tonko pi ma Juke li kama lon ma Jele li toki e soweli. jan Tonko li weka la, soweli li kama seli."/>
                <para LINESPMode="0"/>
                <ITEXT CH="kulupu li sona e ken seli, li wile ala a e seli, li utala wawa e ona. taso pakala ante li awen kama. sike #LTW la jan wan li kama jo e soweli kepeken ala nasin lawa. lawa ma li utala e ona. sike #LL la noka soweli li wawa ala li pakala. soweli li kama anpa. sike #LLW la ilo tawa li utala wawa e soweli. sike #MLLL la telo suli li moku e soweli. sike #MMLLLTW la waso mute li moku e soweli. sike #MMM la kon wawa li tawa, li tawa anpa e soweli. lukin la soweli li kama lape."/>
                <para LINESPMode="0"/>
                <ITEXT CH="lawa ma la, kulupu poka kin la, pakala soweli o pini o kama sin ala. taso ike pakala li seme? pakala taso la jan mute li kama sona e soweli e ma lili kin. jan mute li wile kama li wile lukin. ken la jan musi li ken wawa e mani ma. pakala ni li wawa a e musi."/>
                <para LINESPMode="0"/>
                <ITEXT CH="o musi lon tenpo lete. o tawa ma Jele. o lukin e soweli Jele."/>
                <breakline/>
                <ITEXT CH="taso o seli ala e ona. lawa ma li ken utala e sina."/>
                <para LINESPMode="0"/>
            </StoryText>
        </PAGEOBJECT>
