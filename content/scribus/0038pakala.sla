        <PAGEOBJECT XPOS="589.606299212598" YPOS="3316.53543307087" OwnPage="10" ItemID="999089878" PTYPE="4" WIDTH="170.078543307087" HEIGHT="538.582677165356" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 538.583 L0 538.583 L0 0 Z" copath="M0 0 L170.079 0 L170.079 538.583 L0 538.583 L0 0 Z" gXpos="589.606299212598" gYpos="3316.53543307087" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="999134598" BACKITEM="970027302"/>
