        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="4620.47244094488" OwnPage="14" ItemID="277363568" PTYPE="4" WIDTH="129.256886885672" HEIGHT="51.0236" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L129.257 0 L129.257 51.0236 L0 51.0236 L0 0 Z" copath="M0 0 L129.257 0 L129.257 51.0236 L0 51.0236 L0 0 Z" gXpos="589.606299212598" gYpos="4620.47244094488" gWidth="129.256886885672" gHeight="51.0236" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
