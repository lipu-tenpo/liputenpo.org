        <PAGEOBJECT XPOS="383.785749699649" YPOS="2664.56692913385" OwnPage="7" ItemID="279464832" PTYPE="2" WIDTH="128.176665955033" HEIGHT="122.547681539807" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.117270508650533" LOCALSCY="0.117270508650533" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../img/0038-nanpa-pakala/sike-tawa-kule.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L128.177 0 L128.177 122.548 L0 122.548 L0 0 Z" copath="M0 0 L128.177 0 L128.177 122.548 L0 122.548 L0 0 Z" gXpos="383.785749699649" gYpos="2664.56692913385" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="773.857874015748" YPOS="1035.49606299213" OwnPage="2" ItemID="279467664" PTYPE="4" WIDTH="170.079102362205" HEIGHT="211.748031496063" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 211.748 L0 211.748 L0 0 Z" copath="M0 0 L170.079 0 L170.079 211.748 L0 211.748 L0 0 Z" gXpos="773.857874015748" gYpos="1035.49606299213" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="279510144" BACKITEM="279134624"/>
        <PAGEOBJECT XPOS="589.606299212597" YPOS="1560.49606299213" OwnPage="4" ItemID="279470496" PTYPE="4" WIDTH="170.078543307087" HEIGHT="338.716535433071" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 338.717 L0 338.717 L0 0 Z" copath="M0 0 L170.079 0 L170.079 338.717 L0 338.717 L0 0 Z" gXpos="589.606299212597" gYpos="1560.49606299213" gWidth="170.078543307087" gHeight="144.160979877515" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="279478992" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text145_BoldItalic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="sina wile alasa e"/>
                <nbspace CPARENT="Text145_BoldItalic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text145_BoldItalic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ijo kiwen lili la, sina ken tawa ma wan taso."/>
                <ITEXT CH=" mi toki e"/>
                <nbspace/>
                <ITEXT CH="tomo sona lon ma Suwasi. nimi ona li"/>
                <nbspace/>
                <ITEXT CH="tomo Sen (toki Inli la, nimi li"/>
                <nbspace/>
                <ITEXT CH="CERN). tomo ni li"/>
                <nbspace/>
                <ITEXT CH="suli la, jan mute en ilo pi alasa sona li"/>
                <nbspace/>
                <ITEXT CH="lon. nanpa wan la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="jan ni. nanpa tu la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="ilo ni. pini la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="alasa ni."/>
                <para/>
                <ITEXT CH="jan pali mute li"/>
                <nbspace/>
                <ITEXT CH="lon tomo sona. jan ni li"/>
                <nbspace/>
                <ITEXT CH="kama tan ma weka mute. ona li"/>
                <nbspace/>
                <ITEXT CH="toki ante li"/>
                <nbspace/>
                <ITEXT CH="pilin ante. ona li"/>
                <nbspace/>
                <ITEXT CH="toki insa e"/>
                <nbspace/>
                <ITEXT CH="ni: “mi wile pali, mi wile sona”. tan ni la, jan ale li"/>
                <nbspace/>
                <ITEXT CH="pali lon kulupu. pali jan li"/>
                <nbspace/>
                <ITEXT CH="ken ante mute. jan wan li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="ilo kepeken luka ona. jan ante li"/>
                <nbspace/>
                <ITEXT CH="toki tawa ilo nanpa. sina lon tomo la, sina kute e"/>
                <nbspace/>
                <ITEXT CH="toki musi!"/>
                <para/>
                <ITEXT CH="jan ni li"/>
                <nbspace/>
                <ITEXT CH="kama lon tomo ni tan seme? nanpa wan la mi toki e"/>
                <nbspace/>
                <ITEXT CH="sona. mi en sina li"/>
                <nbspace/>
                <ITEXT CH="tan ijo kiwen lili (anu kiwen). lon la, ale li"/>
                <nbspace/>
                <ITEXT CH="tan kiwen. jan li"/>
                <nbspace/>
                <ITEXT CH="toki insa e"/>
                <nbspace/>
                <ITEXT CH="ni: &quot;kiwen li"/>
                <nbspace/>
                <ITEXT CH="seme? mi wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni. mi o"/>
                <nbspace/>
                <ITEXT CH="tawa tomo sona la, mi ken sona.&quot; tomo ni li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="ilo sin. nimi ona li"/>
                <nbspace/>
                <ITEXT CH="ilo suli pi pakala lili (toki Inli la, nimi li"/>
                <nbspace/>
                <ITEXT CH="LHC). ilo li"/>
                <nbspace/>
                <ITEXT CH="sike suli li"/>
                <nbspace/>
                <ITEXT CH="lon insa ma. ilo li"/>
                <nbspace/>
                <ITEXT CH="ken pana e"/>
                <nbspace/>
                <ITEXT CH="wawa tawa la, kiwen li"/>
                <nbspace/>
                <ITEXT CH="tawa. kiwen li"/>
                <nbspace/>
                <ITEXT CH="tawa kiwen la, ona tu li"/>
                <nbspace/>
                <ITEXT CH="pakala! kiwen tu li"/>
                <nbspace/>
                <ITEXT CH="kama kiwen mute ante. jan li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ni la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama sona pona e"/>
                <nbspace/>
                <ITEXT CH="ijo kiwen."/>
                <para/>
                <ITEXT CH="pini la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="alasa sona. sona ni li"/>
                <nbspace/>
                <ITEXT CH="seme? kiwen li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="wawa, e"/>
                <nbspace/>
                <ITEXT CH="olin. wawa li"/>
                <nbspace/>
                <ITEXT CH="ni. wawa kiwen li"/>
                <nbspace/>
                <ITEXT CH="suli la, ona li"/>
                <nbspace/>
                <ITEXT CH="ken mama e"/>
                <nbspace/>
                <ITEXT CH="kiwen mute. wawa kiwen li"/>
                <nbspace/>
                <ITEXT CH="lili la, ona li"/>
                <nbspace/>
                <ITEXT CH="ken ala. olin li"/>
                <nbspace/>
                <ITEXT CH="ni. open la, kiwen wan en kiwen ante li"/>
                <nbspace/>
                <ITEXT CH="lon nasin linja sama. kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="tawa kiwen ante. tenpo ni la, ona li"/>
                <nbspace/>
                <ITEXT CH="poka. kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="tawa lon nasin linja la, ona li"/>
                <nbspace/>
                <ITEXT CH="olin ala e"/>
                <nbspace/>
                <ITEXT CH="kiwen ante. kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="tawa lon nasin sin la, ona li"/>
                <nbspace/>
                <ITEXT CH="olin e"/>
                <nbspace/>
                <ITEXT CH="kiwen ante. jan li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="sona ni: kiwen li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="wawa seme? kiwen li"/>
                <nbspace/>
                <ITEXT CH="olin e"/>
                <nbspace/>
                <ITEXT CH="seme?"/>
                <para/>
                <ITEXT CH="jan li"/>
                <nbspace/>
                <ITEXT CH="ken ala ken kama sona e"/>
                <nbspace/>
                <ITEXT CH="ni? ona li"/>
                <nbspace/>
                <ITEXT CH="pali mute, li"/>
                <nbspace/>
                <ITEXT CH="lape lili. ona li"/>
                <nbspace/>
                <ITEXT CH="sitelen e"/>
                <nbspace/>
                <ITEXT CH="lipu sona. tenpo kama la, mi wile e"/>
                <nbspace/>
                <ITEXT CH="ni: mi mute li"/>
                <nbspace/>
                <ITEXT CH="sona."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="1539.49606299213" OwnPage="4" ItemID="279473328" PTYPE="4" WIDTH="170.078543307087" HEIGHT="12.6372120151659" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Kopie von Copy of lawa_1 (5)" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 12.6372 L0 12.6372 L0 0 Z" copath="M0 0 L170.079 0 L170.079 12.6372 L0 12.6372 L0 0 Z" gXpos="311.810728346457" gYpos="-1195.2911392405" gWidth="170.078543307087" gHeight="76.5354330708665" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
