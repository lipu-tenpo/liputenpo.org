        <PAGEOBJECT XPOS="589.606299212598" YPOS="2208.18897637795" OwnPage="6" ItemID="277394720" PTYPE="4" WIDTH="170.078543307087" HEIGHT="342.992125984252" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 342.992 L0 342.992 L0 0 Z" copath="M0 0 L170.079 0 L170.079 342.992 L0 342.992 L0 0 Z" gXpos="589.606299212598" gYpos="2208.18897637795" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="277397552" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ijo mute li"/>
                <nbspace FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="pakala."/>
                <ITEXT CH=" suno pini la mi pakala e"/>
                <nbspace/>
                <ITEXT CH="poki telo mi. taso mi kama sona e"/>
                <nbspace/>
                <ITEXT CH="ijo ala tan pakala. pakala ante li"/>
                <nbspace/>
                <ITEXT CH="lon: sona sin anu ijo sin li"/>
                <nbspace/>
                <ITEXT CH="kama tan pakala ni. toki ni la mi toki e"/>
                <nbspace/>
                <ITEXT CH="pakala ni tu wan:"/>
                <para/>
                <ITEXT FONT="Andika Bold" FONTSIZE="8.5" CH="misikeke Penisilin"/>
                <para/>
                <ITEXT CH="jan Alesanta Lemin ("/>
                <ITEXT CPARENT="Text141_Italic" CH="Alexander Fleming"/>
                <ITEXT CH=") li"/>
                <nbspace/>
                <ITEXT CH="jan misikeke, li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="sona sin pi pipi lili. sina ken ala lukin e"/>
                <nbspace/>
                <ITEXT CH="pipi ni kepeken oko taso; sina o"/>
                <nbspace/>
                <ITEXT CH="kepeken e"/>
                <nbspace/>
                <ITEXT CH="ilo lukin. pipi lili ni li"/>
                <nbspace/>
                <ITEXT CH="jaki li"/>
                <nbspace/>
                <ITEXT CH="ike tawa sijelo jan. nimi ona li"/>
                <nbspace/>
                <ITEXT CH="pipi "/>
                <ITEXT CPARENT="Text141_Italic" CH="Staphylococcus"/>
                <ITEXT CH=". jan Lemin li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="moku tawa ona lon poki lili."/>
                <para/>
                <ITEXT CH="suno wan la ona li"/>
                <nbspace/>
                <ITEXT CH="kama sin lon tomo ona. tomo ni li"/>
                <nbspace/>
                <ITEXT CH="lon ma tomo Lonton. ona li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="poki wan. pakala! soko ike li"/>
                <nbspace/>
                <ITEXT CH="lon. ken la jan ante li"/>
                <nbspace/>
                <ITEXT CH="weka e"/>
                <nbspace/>
                <ITEXT CH="poki ni. taso jan Lemin li"/>
                <nbspace/>
                <ITEXT CH="ante. ona li"/>
                <nbspace/>
                <ITEXT CH="jan sona pona: ona li"/>
                <nbspace/>
                <ITEXT CH="lukin pona e"/>
                <nbspace/>
                <ITEXT CH="poki ni."/>
                <para/>
                <ITEXT CH="pipi li"/>
                <nbspace/>
                <ITEXT CH="lon ala poka soko. ona li"/>
                <nbspace/>
                <ITEXT CH="weka. ma ante la pipi li"/>
                <nbspace/>
                <ITEXT CH="awen. ken la… soko li"/>
                <nbspace/>
                <ITEXT CH="moli e"/>
                <nbspace/>
                <ITEXT CH="pipi lili?"/>
                <para/>
                <ITEXT CH="jan Lemin li kama sona e ni: soko ni li moli e pipi lili. kama la jan li nimi e soko ni: soko Penisilin. misikeke la soko Penisilin li suli a. ona li ken moli e pipi lili ike lon sijelo sina. tenpo ni kin la jan li kepeken e soko Penisilin."/>
                <para/>
                <ITEXT FONT="Andika Bold" FONTSIZE="8.5" CH="kalama tan pimeja"/>
                <para PARENT="Text141_Heading 2"/>
                <ITEXT CH="jan Ano Pensi ("/>
                <ITEXT CPARENT="Text141_Italic" CH="Arno Penzias"/>
                <ITEXT CH=") en jan Ope Wison ("/>
                <ITEXT CPARENT="Text141_Italic" CH="Robert Wilson"/>
                <ITEXT CH=") li jan pi pali sona. ona li kepeken e ilo kute suli lon ma Nusesi ("/>
                <ITEXT CPARENT="Text141_Italic" CH="New Jersey"/>
                <ITEXT CH="). ona li wile kute e kalama tan sewi, tan mun. ona li wile kama sona e ni: mun ante li pana e kalama seme."/>
                <para/>
                <ITEXT CH="sina ken ala kute e kalama ni. mi o nimi e ona: kalama Lajo. ilo kalama musi li kepeken e kalama Lajo. ilo wan li lon ma weka la ilo ante li ken kalama kepeken kalama Lajo tawa ona. ijo ale lon sewi li pana e kalama Lajo."/>
                <para/>
                <ITEXT CH="jan Pensi en jan Wison li kepeken e ilo kute pona a. taso ona pilin e ni: ilo li pakala a! ona li pilin e ni: kalama pakala li lon li weka ala. ona li wile kute e ma pimeja la ona li awen kute e kalama pakala ni. taso ma pimeja la mun ala li lon; ala li lon ma pimeja. ni la ona li pimeja. taso kalama pakala ni li lon."/>
                <para/>
                <ITEXT CH="ona li kama sona e ni: ilo li pakala ala a! – tenpo sama la jan ante li pilin li wile kama sona e sona pi open ale. ona li pilin e ni: open ale la pakala suli li lon. ale li lon ma lili li pakala a li kama suli. ni la ijo ale li seli a lon tenpo pi open ale. ijo seli li pana e kalama Lajo."/>
                <para/>
                <ITEXT CH="jan Pensi en jan Wison li kama sona e ni: kalama Lajo li kama tan tenpo pi open ale. sona ni li pona mute tawa kama sona pi open ale. kalama pakala ni li kalama pakala ala li kalama pi open ale."/>
                <para/>
                <ITEXT FONT="Andika Bold" FONTSIZE="8.5" CH="ko wawa"/>
                <para PARENT="Text141_Heading 2"/>
                <ITEXT CH="tenpo pini la jan li kama sona e ni: kasi pi ma seli li pana e ko pona. jan li ken kepeken e ko ni tawa ijo mute. ona li ken kama lili li ken kama suli li pakala ala. telo li ike ala tawa ona. tenpo ni la sina sona e ko ni tan tomo tawa: sike pi tomo tawa li tan ko ni."/>
                <para/>
                <ITEXT CH="ike la ko ni li pona taso ala. seli li telo e ona! lete li kiwen e ona a! sina wile ala e ni: sike pi tomo tawa sina li kama telo anu kiwen. jan Sale Kuje ("/>
                <ITEXT CPARENT="Text141_Italic" CH="Charles Goodyear"/>
                <ITEXT CH=") li wile pona e ko ni. ona li pilin e ni: ko ni li pakala ala tan lete anu seli la ona li ko wawa tawa ijo mute! ni la ona li pana e ijo ante mute tawa ona. ona li pali mute a, taso tenpo ale la ko li kama pakala."/>
                <para/>
                <ITEXT CH="tenpo wan la jan Kuje li pakala, taso pakala ni li ike ala: ona li supa e poki lon supa seli. poki la ko en ijo ante li lon. ijo ni li ijo nanpa 16 li ijo Supu. nimi ni li tan toki Lasina ("/>
                <ITEXT CPARENT="Text141_Italic" CH="sulphur"/>
                <ITEXT CH="). seli en ijo Supu li pakala ala e ko: ona li kama wawa. tenpo ni la ona li pakala ala tan seli tan lete."/>
                <para/>
                <ITEXT CH="kepeken nasin pali ni la jan li ken wawa e ko kasi li ken kepeken e ona tawa ijo mute a. ken kin la sina sona e nimi Kuje ("/>
                <ITEXT CPARENT="Text141_Italic" CH="Goodyear"/>
                <ITEXT CH=") tan ni: kulupu pali Kuje li pali e sike tawa tomo tawa. taso jan Kuje li open ala e kulupu pali ni. jan li kepeken taso e nimi ona."/>
                <para/>
                <ITEXT FONT="Andika Bold" FONTSIZE="8.5" CH="sona tan pakala"/>
                <para PARENT="Text141_Heading 2"/>
                <ITEXT CH="sina wile kama jo e sona tan pakala la o lukin pona! jan ale pi toki ni li jan pona pi pali sona. ona li lukin pona e ijo lili e pakala lili kin. kama la sina pakala la o lukin pona: ken la pona li ken kama tan pakala ni."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
