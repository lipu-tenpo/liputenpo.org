            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Bold" FONTSIZE="8.5" FCOLOR="jelo pimeja" FSHADE="100" CH="tenpo pini lili la"/>
                <ITEXT FONTSIZE="8.5" FCOLOR="Black" FSHADE="100" CH=" "/>
                <ITEXT FONTSIZE="8.5" CH="jan pi toki pona li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="kulupu lon ma tomo Aken lon ma Tosi. jan Alonola en jan Melisuwi li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="open e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="tomo ona tawa jan kama. ona tu li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pona a. ni la jan pi ma mute li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="kama kulupu. ona ale la jan luka li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="lon kulupu pali pi lipu tenpo."/>
                <para/>
                <ITEXT FONTSIZE="8.5" CH="mi kama lon la jan li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="seli e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pan linja. mi ale li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="moku pona li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="toki pona lon ma kasi lili. mi pilin pona tan ni: mi sona e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="jan ale tan tenpo kulupu pini li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="kulupu sin lon poka ona. tenpo pimeja la mi musi kepeken lipu musi li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="toki mute."/>
                <para/>
                <ITEXT FONTSIZE="8.5" CH="kin la mi mute li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="lukin e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="ma tomo Aken. jan Alonola li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="toki e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="ijo suli ona. ma tomo Aken li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="jo e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="tomo sewi suli e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="open telo nasa. open telo li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pona tawa sijelo. taso ona li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="ike a tawa pilin nena. tenpo ante la mi tawa ma pi ma tu wan kepeken ilo. ma Netelan en ma Pesike en ma Tosi li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="lon poka ni. mi lukin e ma ni li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="tawa lon ma kasi ona."/>
                <para/>
                <ITEXT FONTSIZE="8.5" CH="tenpo lawa la mi mute li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="kulupu lon poka pi jan ante pi lipu tenpo li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="toki e lawa ona. mi pana e sona sin li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="toki e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pilin e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pali pi tenpo kama. jan mute li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="wile pali e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="ijo sin. pini la jan Alonola li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="pana e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="lipu tenpo mute ona tawa jan ale. tenpo ni la jan lon ma mute li"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="jo e"/>
                <nbspace FONTSIZE="8.5"/>
                <ITEXT FONTSIZE="8.5" CH="lipu tenpo mute lon tomo ona."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
