            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text145_BoldItalic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="sina wile alasa e"/>
                <nbspace CPARENT="Text145_BoldItalic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text145_BoldItalic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ijo kiwen lili la, sina ken tawa ma wan taso."/>
                <ITEXT CH=" mi toki e"/>
                <nbspace/>
                <ITEXT CH="tomo sona lon ma Suwasi. nimi ona li"/>
                <nbspace/>
                <ITEXT CH="tomo Sen (toki Inli la, nimi li"/>
                <nbspace/>
                <ITEXT FONTFEATURES="-clig,+c2sc,+ss01" CH="CERN"/>
                <ITEXT CH="). tomo ni li"/>
                <nbspace/>
                <ITEXT CH="suli la, jan mute en ilo pi alasa sona li"/>
                <nbspace/>
                <ITEXT CH="lon. nanpa wan la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="jan ni. nanpa tu la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="ilo ni. pini la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="alasa ni."/>
                <para/>
                <ITEXT CH="jan pali mute li"/>
                <nbspace/>
                <ITEXT CH="lon tomo sona. jan ni li"/>
                <nbspace/>
                <ITEXT CH="kama tan ma weka mute. ona li"/>
                <nbspace/>
                <ITEXT CH="toki ante li"/>
                <nbspace/>
                <ITEXT CH="pilin ante. ona li"/>
                <nbspace/>
                <ITEXT CH="toki insa e"/>
                <nbspace/>
                <ITEXT CH="ni: “mi wile pali, mi wile sona”. tan ni la, jan ale li"/>
                <nbspace/>
                <ITEXT CH="pali lon kulupu. pali jan li"/>
                <nbspace/>
                <ITEXT CH="ken ante mute. jan wan li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="ilo kepeken luka ona. jan ante li"/>
                <nbspace/>
                <ITEXT CH="toki tawa ilo nanpa. sina lon tomo la, sina kute e"/>
                <nbspace/>
                <ITEXT CH="toki musi!"/>
                <para/>
                <ITEXT CH="jan ni li"/>
                <nbspace/>
                <ITEXT CH="kama lon tomo ni tan seme? nanpa wan la mi toki e"/>
                <nbspace/>
                <ITEXT CH="sona. mi en sina li"/>
                <nbspace/>
                <ITEXT CH="tan ijo kiwen lili (anu kiwen). lon la, ale li"/>
                <nbspace/>
                <ITEXT CH="tan kiwen. jan li"/>
                <nbspace/>
                <ITEXT CH="toki insa e"/>
                <nbspace/>
                <ITEXT CH="ni: &quot;kiwen li"/>
                <nbspace/>
                <ITEXT CH="seme? mi wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni. mi o"/>
                <nbspace/>
                <ITEXT CH="tawa tomo sona la, mi ken sona.&quot; tomo ni li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="ilo sin. nimi ona li"/>
                <nbspace/>
                <ITEXT CH="ilo suli pi pakala lili (toki Inli la, nimi li"/>
                <nbspace/>
                <ITEXT FONTFEATURES="-clig,+c2sc,+ss01" CH="LHC"/>
                <ITEXT CH="). ilo li"/>
                <nbspace/>
                <ITEXT CH="sike suli li"/>
                <nbspace/>
                <ITEXT CH="lon insa ma. ilo li"/>
                <nbspace/>
                <ITEXT CH="ken pana e"/>
                <nbspace/>
                <ITEXT CH="wawa tawa la, kiwen li"/>
                <nbspace/>
                <ITEXT CH="tawa. kiwen li"/>
                <nbspace/>
                <ITEXT CH="tawa kiwen la, ona tu li"/>
                <nbspace/>
                <ITEXT CH="pakala! kiwen tu li"/>
                <nbspace/>
                <ITEXT CH="kama kiwen mute ante. jan li"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ni la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama sona pona e"/>
                <nbspace/>
                <ITEXT CH="ijo kiwen."/>
                <para/>
                <ITEXT CH="pini la, mi toki e"/>
                <nbspace/>
                <ITEXT CH="alasa sona. sona ni li"/>
                <nbspace/>
                <ITEXT CH="seme? kiwen li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="wawa, e"/>
                <nbspace/>
                <ITEXT CH="olin. wawa li"/>
                <nbspace/>
                <ITEXT CH="ni. wawa kiwen li"/>
                <nbspace/>
                <ITEXT CH="suli la, ona li"/>
                <nbspace/>
                <ITEXT CH="ken mama e"/>
                <nbspace/>
                <ITEXT CH="kiwen mute. wawa kiwen li"/>
                <nbspace/>
                <ITEXT CH="lili la, ona li"/>
                <nbspace/>
                <ITEXT CH="ken ala. olin li"/>
                <nbspace/>
                <ITEXT CH="ni. open la, kiwen wan en kiwen ante li"/>
                <nbspace/>
                <ITEXT CH="lon nasin linja sama. kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="tawa kiwen ante. tenpo ni la, ona li"/>
                <nbspace/>
                <ITEXT CH="poka. kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="tawa lon nasin linja la, ona li"/>
                <nbspace/>
                <ITEXT CH="olin ala e"/>
                <nbspace/>
                <ITEXT CH="kiwen ante. kiwen wan li"/>
                <nbspace/>
                <ITEXT CH="tawa lon nasin sin la, ona li"/>
                <nbspace/>
                <ITEXT CH="olin e"/>
                <nbspace/>
                <ITEXT CH="kiwen ante. jan li"/>
                <nbspace/>
                <ITEXT CH="alasa e"/>
                <nbspace/>
                <ITEXT CH="sona ni: kiwen li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="wawa seme? kiwen li"/>
                <nbspace/>
                <ITEXT CH="olin e"/>
                <nbspace/>
                <ITEXT CH="seme?"/>
                <para/>
                <ITEXT CH="jan li"/>
                <nbspace/>
                <ITEXT CH="ken ala ken kama sona e"/>
                <nbspace/>
                <ITEXT CH="ni? ona li"/>
                <nbspace/>
                <ITEXT CH="pali mute, li"/>
                <nbspace/>
                <ITEXT CH="lape lili. ona li"/>
                <nbspace/>
                <ITEXT CH="sitelen e"/>
                <nbspace/>
                <ITEXT CH="lipu sona. tenpo kama la, mi wile e"/>
                <nbspace/>
                <ITEXT CH="ni: mi mute li"/>
                <nbspace/>
                <ITEXT CH="sona."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
