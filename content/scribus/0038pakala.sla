        <PAGEOBJECT XPOS="206.535449647741" YPOS="3968.50393700787" OwnPage="11" ItemID="987466235" PTYPE="4" WIDTH="119.496055310894" HEIGHT="69.4488" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L119.496 0 L119.496 69.4488 L0 69.4488 L0 0 Z" copath="M0 0 L119.496 0 L119.496 69.4488 L0 69.4488 L0 0 Z" gXpos="206.535449647741" gYpos="3968.50393700787" gWidth="119.496055310894" gHeight="69.4488" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
