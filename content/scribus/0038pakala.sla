            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT FONT="Andika Bold" FCOLOR="unu pimeja" FSHADE="100" CH="mama li moli la"/>
                <ITEXT FONT="Andika Bold" CH=" "/>
                <ITEXT CH="kon pini uta"/>
                <breakline/>
                <ITEXT CH="li ni e kute mi: “sina ken sin"/>
                <breakline/>
                <ITEXT CH="e jan tan moli. len mi la o luka"/>
                <breakline/>
                <ITEXT CH="e lipu lili mi o sama ni: n…!–”"/>
                <breakline/>
                <ITEXT CH="tan len la lipu jelo jaki wan"/>
                <breakline/>
                <ITEXT CH="li pana pakala e sona nasin:"/>
                <breakline/>
                <ITEXT CH="“mun sin la o ken tawa open jan"/>
                <breakline/>
                <ITEXT CH="lon nasin telo S"/>
                <ITEXT FONT="Liberation Mono Regular" CH="███"/>
                <ITEXT CH=" tawa ma sin.”"/>
                <breakline/>
                <ITEXT CH="mi alasa lon telo S… ale;"/>
                <breakline/>
                <ITEXT CH="mun nanpa ale wan la wawa telo"/>
                <breakline/>
                <ITEXT CH="li sin e ma tan tenpo open tenpo."/>
                <breakline/>
                <ITEXT CH="mi tawa ma li tawa tomo jelo."/>
                <breakline/>
                <ITEXT CH="n. sinpin wan la sitelen li awen:"/>
                <breakline/>
                <ITEXT CH="“moli li moli la o pakala e n…!–"/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
