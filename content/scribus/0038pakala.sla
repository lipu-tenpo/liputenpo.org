        <PAGEOBJECT XPOS="773.857842519684" YPOS="3316.53543307087" OwnPage="10" ItemID="279493152" PTYPE="4" WIDTH="170.079165354331" HEIGHT="538.582677165355" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 538.583 L0 538.583 L0 0 Z" copath="M0 0 L170.079 0 L170.079 538.583 L0 538.583 L0 0 Z" gXpos="773.857842519684" gYpos="3316.53543307087" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="279484656"/>
        <PAGEOBJECT XPOS="178.582677165354" YPOS="1572.63892013498" OwnPage="3" ItemID="279495984" PTYPE="4" WIDTH="170.079165354331" HEIGHT="326.573678290214" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 326.574 L0 326.574 L0 0 Z" copath="M0 0 L170.079 0 L170.079 326.574 L0 326.574 L0 0 Z" gXpos="178.582677165354" gYpos="1572.63892013498" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="279501648" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text157_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-3" CH="ma Pilipina la, telo sewi li"/>
                <nbspace CPARENT="Text157_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-3"/>
                <ITEXT CPARENT="Text157_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-3" CH="pakala e"/>
                <nbspace CPARENT="Text157_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-3"/>
                <ITEXT CPARENT="Text157_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" KERN="-3" CH="ijo mute."/>
                <ITEXT CH=" tenpo pini la, tenpo pi telo sewi li"/>
                <nbspace/>
                <ITEXT CH="lon. tenpo ni la, ko sewi suli MTW li"/>
                <nbspace/>
                <ITEXT CH="kama lon, li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="telo mute tawa ma ni. ni la, jan li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="ni: sinpin o"/>
                <nbspace/>
                <ITEXT CH="lon o"/>
                <nbspace/>
                <ITEXT CH="awen e"/>
                <nbspace/>
                <ITEXT CH="telo suli. telo mute li"/>
                <nbspace/>
                <ITEXT CH="kama la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama ala lon nasin lon tomo jan. ni la, lawa ma li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="ona. ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="pali ni tawa kulupu pali. taso a, pali ona li"/>
                <nbspace/>
                <ITEXT CH="ike, anu lon ala! sina jan Pilipina la, ken la, sina kute e"/>
                <nbspace/>
                <ITEXT CH="ni lon tenpo poka. tan seme la ni li"/>
                <nbspace/>
                <ITEXT CH="lon?"/>
                <para ALIGN="0" DIRECTION="0"/>
                <ITEXT CH="nanpa wan la, lawa ma en jan li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="sinpin. ona li"/>
                <nbspace/>
                <ITEXT CH="toki tawa jan pali, li"/>
                <nbspace/>
                <ITEXT CH="wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni: “mi o"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="mani pi mute seme?” kulupu pali li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: “mani pi mute suli a!” ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="mani pi mute ike. "/>
                <ITEXT CPARENT="Text157_Italic" CH="seme la ona li"/>
                <nbspace CPARENT="Text157_Italic"/>
                <ITEXT CPARENT="Text157_Italic" CH="wile e"/>
                <nbspace CPARENT="Text157_Italic"/>
                <ITEXT CPARENT="Text157_Italic" CH="mani pi mute ike?"/>
                <ITEXT CH=" nanpa tu la, o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ijo ona. jan lawa li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="mani mute. taso, lawa ma li"/>
                <nbspace/>
                <ITEXT CH="pana ala e"/>
                <nbspace/>
                <ITEXT CH="mani pi mute ni tawa ona. ni la, "/>
                <ITEXT CPARENT="Text157_Italic" CH="mani ona li"/>
                <nbspace CPARENT="Text157_Italic"/>
                <ITEXT CPARENT="Text157_Italic" CH="kama tan seme?"/>
                <ITEXT CH=" nanpa tu wan la, o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="kulupu pali ni. jan lawa li"/>
                <nbspace/>
                <ITEXT CH="lawa e"/>
                <nbspace/>
                <ITEXT CH="ona mute. "/>
                <ITEXT CPARENT="Text157_Italic" CH="seme la ona li"/>
                <nbspace CPARENT="Text157_Italic"/>
                <ITEXT CPARENT="Text157_Italic" CH="lawa e"/>
                <nbspace CPARENT="Text157_Italic"/>
                <ITEXT CPARENT="Text157_Italic" CH="kulupu pali mute?"/>
                <ITEXT CH=" nanpa pini la, o lukin e pali ona. lawa ma li pana e mani mute tawa ona, taso ona li pali ike anu pali ala. ni la, "/>
                <ITEXT CPARENT="Text157_Italic" CH="mani li tawa seme a?"/>
                <para/>
                <ITEXT CH="tenpo ni la, mi pana e wile sona tu tu tawa sina:"/>
                <para/>
                <ITEXT CH="seme la kulupu pali li wile e mani pi mute ike?"/>
                <para PARENT="Text157_List 2"/>
                <ITEXT CH="mani pi jan lawa li kama tan seme?"/>
                <para PARENT="Text157_List 2"/>
                <ITEXT CH="seme la jan lawa li lawa e kulupu pali mute?"/>
                <para PARENT="Text157_List 2"/>
                <ITEXT CH="pali li ike la, mani li tawa seme?"/>
                <para PARENT="Text157_List 2"/>
                <ITEXT CH="ni la, sina ken lukin e ni: sina wan e wile sona ni tu tu la, sona wile li kama."/>
                <para/>
                <ITEXT CH="jan lawa li lawa e kulupu pali mute. lawa ma li wile pali e ijo la, ona li toki tawa kulupu pali. “sina wile e mani pi mute seme?” la, lawa ma li toki. jan lawa li wile e mani. ni la, ona li toki e ni tawa kulupu pali: “o toki e ni: sina wile e mani mute.” kulupu pali li ni. tan ni la, lawa ma li pana e mani pi mute ni. taso a, jan lawa li lanpan e mani mute tan mani pana. ni la, kulupu pali li pali kepeken mani lili taso. pali ona li pona ala anu lon ala. jan lawa li lawa e kulupu pali tan ni: ona li ken lanpan e mani."/>
                <para/>
                <ITEXT CH="taso a, lawa ma li kama sona e ni lon tenpo poka. tan ni la, ona li alasa e jan lawa ike. ona li alasa sona e tan pi mani ona. ona li alasa sona kin e kulupu pali ona. ni la, seme li lon?"/>
                <para/>
                <ITEXT CH="tenpo ni la, jan lawa ike mute li kama lon tomo lawa. lawa ma li utala e ona, li kama jo e sona pi mani ona. tan utala ni la, jan lawa ike mute li anpa tan tenpo lawa ona."/>
                <para/>
                <ITEXT CH="taso a, pali ike mute li awen lon. lawa li awen utala e jan lawa ike tan ni. taso mi sona e ni: pona lili li kama open."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="362.834220472442" YPOS="1494.9246344207" OwnPage="3" ItemID="279501648" PTYPE="4" WIDTH="170.078543307087" HEIGHT="404.2879640045" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 404.288 L0 404.288 L0 0 Z" copath="M0 0 L170.079 0 L170.079 404.288 L0 404.288 L0 0 Z" gXpos="362.834220472442" gYpos="1494.9246344207" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="279490320" BACKITEM="279495984"/>
