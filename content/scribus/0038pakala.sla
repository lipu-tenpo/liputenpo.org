        <PAGEOBJECT XPOS="577.982047025014" YPOS="5032.2829455409" OwnPage="14" ItemID="277406048" PTYPE="7" WIDTH="6.54070866141696" HEIGHT="6" FRTYPE="3" CLIPEDIT="1" PWIDTH="0.599998069561323" PCOLOR="unu pimeja" PLINEART="1" ANNAME="sama_unu" TEXTFLOWMODE="1" path="M0 4.96045 C0.0266729 5.06573 -0.0118947 5.43054 0.159714 5.59229 C0.488764 5.90266 1.58225 5.95202 2.45302 5.98352 C3.59304 6.02478 5.97137 6.01858 6.41978 5.5986 C6.59791 5.43188 6.52047 5.06678 6.54058 4.96045 C6.5204 4.85409 6.59791 4.48899 6.41978 4.32227 C5.97137 3.90247 3.59304 3.89611 2.45302 3.93735 C1.58225 3.96868 0.488764 4.01823 0.159714 4.32858 C-0.0117866 4.49033 0.026601 4.85514 0 4.96045 L0 4.96045 M0 1.05652 C0.0245103 1.16291 -0.0328006 1.52841 0.147999 1.69491 C0.562511 2.07701 2.39663 2.10296 3.46584 2.10975 C4.46491 2.11608 5.96757 2.14554 6.36682 1.7844 C6.56573 1.60452 6.51159 1.17782 6.54058 1.05652 C6.51175 0.935186 6.5658 0.508527 6.36682 0.328608 C5.96757 -0.0323476 4.46491 -0.00307581 3.46584 0.00326329 C2.39663 0.00997526 0.562511 0.0360775 0.147999 0.418101 C-0.0326202 0.584633 0.0246546 0.9501 0 1.05652 " copath="M0 4.96045 C0.0266729 5.06573 -0.0118947 5.43054 0.159714 5.59229 C0.488764 5.90266 1.58225 5.95202 2.45302 5.98352 C3.59304 6.02478 5.97137 6.01858 6.41978 5.5986 C6.59791 5.43188 6.52047 5.06678 6.54058 4.96045 C6.5204 4.85409 6.59791 4.48899 6.41978 4.32227 C5.97137 3.90247 3.59304 3.89611 2.45302 3.93735 C1.58225 3.96868 0.488764 4.01823 0.159714 4.32858 C-0.0117866 4.49033 0.026601 4.85514 0 4.96045 L0 4.96045 Z M0 1.05652 C0.0245103 1.16291 -0.0328006 1.52841 0.147999 1.69491 C0.562511 2.07701 2.39663 2.10296 3.46584 2.10975 C4.46491 2.11608 5.96757 2.14554 6.36682 1.7844 C6.56573 1.60452 6.51159 1.17782 6.54058 1.05652 C6.51175 0.935186 6.5658 0.508527 6.36682 0.328608 C5.96757 -0.0323476 4.46491 -0.00307581 3.46584 0.00326329 C2.39663 0.00997526 0.562511 0.0360775 0.147999 0.418101 C-0.0326202 0.584633 0.0246546 0.9501 0 1.05652 Z" fillRule="0" gXpos="4