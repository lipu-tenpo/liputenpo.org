            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text173_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ma Pilipina la, telo sewi li"/>
                <nbspace CPARENT="Text173_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text173_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="pakala e"/>
                <nbspace CPARENT="Text173_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text173_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ijo mute."/>
                <ITEXT CH=" tenpo pini la, tenpo pi telo sewi li"/>
                <nbspace/>
                <ITEXT CH="lon. tenpo ni la, ko sewi suli "/>
                <ITEXT FONTFEATURES="-clig,+c2sc,+ss01" CH="MTW"/>
                <ITEXT CH=" li"/>
                <nbspace/>
                <ITEXT CH="kama lon, li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="telo mute tawa ma ni. ni la, jan li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="ni: sinpin o"/>
                <nbspace/>
                <ITEXT CH="lon o"/>
                <nbspace/>
                <ITEXT CH="awen e"/>
                <nbspace/>
                <ITEXT CH="telo suli. telo mute li"/>
                <nbspace/>
                <ITEXT CH="kama la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama ala lon nasin lon tomo jan. ni la, lawa ma li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="ona. ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="pali ni tawa kulupu pali. taso"/>
                <nbspace/>
                <ITEXT CH="a, pali ona li"/>
                <nbspace/>
                <ITEXT CH="ike, anu lon ala! sina jan Pilipina la, ken la, sina kute e"/>
                <nbspace/>
                <ITEXT CH="ni lon tenpo poka. tan seme la ni li"/>
                <nbspace/>
                <ITEXT CH="lon?"/>
                <para/>
                <ITEXT CH="nanpa wan la, lawa ma en jan li"/>
                <nbspace/>
                <ITEXT CH="wile e"/>
                <nbspace/>
                <ITEXT CH="sinpin. ona li"/>
                <nbspace/>
                <ITEXT CH="toki tawa jan pali, li"/>
                <nbspace/>
                <ITEXT CH="wile sona e"/>
                <nbspace/>
                <ITEXT CH="ni: “mi o"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="mani pi mute seme?” kulupu pali li"/>
                <nbspace/>
                <ITEXT CH="toki e"/>
                <nbspace/>
                <ITEXT CH="ni: “mani pi mute suli"/>
                <nbspace/>
                <ITEXT CH="a!” ona li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="mani pi mute ike. "/>
                <ITEXT CPARENT="Text173_Italic" CH="seme la ona li"/>
                <nbspace CPARENT="Text173_Italic"/>
                <ITEXT CPARENT="Text173_Italic" CH="wile e"/>
                <nbspace CPARENT="Text173_Italic"/>
                <ITEXT CPARENT="Text173_Italic" CH="mani pi mute ike?"/>
                <ITEXT CH=" nanpa tu la, o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="ijo ona. jan lawa li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="mani mute. taso, lawa ma li"/>
                <nbspace/>
                <ITEXT CH="pana ala e"/>
                <nbspace/>
                <ITEXT CH="mani pi mute ni tawa ona. ni la, "/>
                <ITEXT CPARENT="Text173_Italic" CH="mani ona li"/>
                <nbspace CPARENT="Text173_Italic"/>
                <ITEXT CPARENT="Text173_Italic" CH="kama tan seme?"/>
                <ITEXT CH=" nanpa tu wan la, o"/>
                <nbspace/>
                <ITEXT CH="lukin e"/>
                <nbspace/>
                <ITEXT CH="kulupu pali ni. jan lawa li"/>
                <nbspace/>
                <ITEXT CH="lawa e"/>
