        <PAGEOBJECT XPOS="589.606299212598" YPOS="2664.56692913385" OwnPage="8" ItemID="123009840" PTYPE="4" WIDTH="170.078543307087" HEIGHT="69.4488188976378" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="14.1732283464567" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 69.4488 L0 69.4488 L0 0 Z" copath="M0 0 L170.079 0 L170.079 69.4488 L0 69.4488 L0 0 Z" gXpos="311.810728346457" gYpos="-1374.15728097279" gWidth="170.078543307087" gHeight="76.5354330708665" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FCOLOR="laso pimeja" FSHADE="100" CH="nena pakala pi ma Pilipina"/>
                <trail PARENT="lawa" ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="2759.52755905511" OwnPage="8" ItemID="277366400" PTYPE="4" WIDTH="170.078543307087" HEIGHT="374.253718285214" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L170.079 0 L170.079 374.254 L0 374.254 L0 0 Z" copath="M0 0 L170.079 0 L170.079 374.254 L0 374.254 L0 0 Z" gXpos="589.606299212598" gYpos="2759.52755905511" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="277400384" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESPMode="1" CPARENT="Default Character Style"/>
                <ITEXT CPARENT="Text156_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="ma Pilipina li"/>
                <nbspace CPARENT="Text156_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text156_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="jo e"/>
                <nbspace CPARENT="Text156_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100"/>
                <ITEXT CPARENT="Text156_Italic" FONT="Andika Bold" FCOLOR="laso pimeja" FSHADE="100" CH="nena pakala mute."/>
                <ITEXT CH=" tenpo ni la, nena pakala tu li"/>
                <nbspace/>
                <ITEXT CH="pakala! nena pakala suli tu tu li"/>
                <nbspace/>
                <ITEXT CH="lon: nena Tala¹, nena Pinatupo², nena Majon³, nena Kanlajon⁴. tenpo poka la, ona li"/>
                <nbspace/>
                <ITEXT CH="pakala, li"/>
                <nbspace/>
                <ITEXT CH="pana e"/>
                <nbspace/>
                <ITEXT CH="kon ike e"/>
                <nbspace/>
                <ITEXT CH="telo sewi tawa ma poka. taso, sina o"/>
                <nbspace/>
                <ITEXT CH="sona e"/>
                <nbspace/>
                <ITEXT CH="ni: seme la ona li"/>
                <nbspace/>
                <ITEXT CH="lon?"/>
                <para/>
                <ITEXT CH="ma Pilipina li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="ma telo mute. ma ni li"/>
                <nbspace/>
                <ITEXT CH="lon poka pi ma telo Pasipiko⁵. lon anpa pi telo suli ni la, ma li"/>
                <nbspace/>
                <ITEXT CH="lon. ona li"/>
                <nbspace/>
                <ITEXT CH="kipisi pi sijelo pi mun jan. kipisi mute sama li"/>
                <nbspace/>
                <ITEXT CH="lon. kipisi ni li"/>
                <nbspace/>
                <ITEXT CH="tawa la, ona li"/>
                <nbspace/>
                <ITEXT CH="tawa kipisi ante, li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="nena e"/>
                <nbspace/>
                <ITEXT CH="lupa e"/>
                <nbspace/>
                <ITEXT CH="ma telo. ona li"/>
                <nbspace/>
                <ITEXT CH="pali e"/>
                <nbspace/>
                <ITEXT CH="nena la, telo seli li"/>
                <nbspace/>
                <ITEXT CH="ken tawa sewi. ni la, nena ni li"/>
                <nbspace/>
                <ITEXT CH="ken kama nena pakala. ni la, ma Pilipina li"/>
                <nbspace/>
                <ITEXT CH="jo e"/>
                <nbspace/>
                <ITEXT CH="nena pakala mute a!"/>
                <para/>
                <ITEXT CH="nanpa wan la, nena Pinatupo. ma tomo Ankele⁶ li"/>
                <nbspace/>
                <ITEXT CH="lon poka ona. tenpo sike #LLLTTAMMMMLLW (nasin nanpa Intu-Alapi la, #1991) la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama pakala. suli la, ona li"/>
                <nbspace/>
                <ITEXT CH="pakala suli nanpa tu lon tenpo ona. ona li"/>
                <nbspace/>
                <ITEXT CH="pakala tan ni: lon sewi ona la, lupa lili li"/>
                <nbspace/>
                <ITEXT CH="lon. telo li"/>
                <nbspace/>
                <ITEXT CH="lon lupa ni. telo ma seli li"/>
                <nbspace/>
                <ITEXT CH="tawa sewi la, ona li"/>
                <nbspace/>
                <ITEXT CH="kama lon poka pi telo ni. ni la, telo li"/>
                <nbspace/>
                <ITEXT CH="kama kon li"/>
                <nbspace/>
                <ITEXT CH="pakala a! kon seli ni li"/>
                <nbspace/>
                <ITEXT CH="tawa seli, li"/>
                <nbspace/>
                <ITEXT CH="tawa anpa lon selo pi nena ni. kon seli ni li jo e ko seli kin. tan ni la, tomo mute li kama pakala lon poka pi nena ni. jan mute li kama jo ala e tomo ona. tomo pi tomo waso Ka li kama pakala kin. taso a, tenpo ni la, lawa li pona e tomo pakala mute. taso, ona li pona e ale ala. pakala mute li awen lon tenpo ni."/>
                <para/>
                <ITEXT CH="nanpa tu la, nena Tala. lon la, ni li nena wan ala. nena suli li lon. lon insa ni la, lupa suli li lon kin. ona li poki e telo. lon insa ni la, nena lili li lon kin. tenpo ni la, ona li jo e lupa, li poki e telo. ona li lon ma lili Kapite⁷ li lon ma lili Patanka⁸. lon poka ni la, ma tomo mute a li lon. open pi tenpo sike #MAM (#2020) la, ona li pakala. tan pi pakala ona li sama pakala pi nena Pinatupo. ko seli li tawa sewi, li kama lon poka telo. ni la, telo li kama kon, li pana e kon seli ike tawa sewi tawa ma. pakala mute li lon, taso ona li suli ala tawa pakala pi nena Pinatupo. tenpo ni la, lawa li awen lukin li awen lawa e nena ni."/>
                <para/>
                <ITEXT CH="nanpa tu wan la, nena Kanlajon. tenpo ni la, ona li awen pakala. pakala ona li lili, taso ona li mute, li suli meso. nena ni li lon ma telo Neko⁹, li lon poka pi ma tomo Kanlajon. pakala mute li lon, taso ona li lili tawa nena Pinatupo tawa nena Tala. taso, ona li pakala mute e ma. lon ma ni la, ma pan mute en ma kili mute li lon. tan pakala ni la, ma ni li pakala, li pana ala e pan e kili. ni la, ma ni li ken ala kama jo e mani tan esun."/>
                <para/>
                <ITEXT CH="nanpa pini la, nena Majon. tenpo ni la, ona li awen pakala, li pakala mute a. nena ni li lon poka pi ma tomo Lekapi¹⁰. tan pi pakala ni li ante lili tawa nena ante lon tenpo ni. telo ma seli li tawa sewi la, ona li awen lon sewi pi nena ni. taso, ona li ken pakala. wawa lili taso li wile. tan ni la, ko seli en nena ni li pakala. ona li pana e kon ike mute tawa sewi, li pana e kon seli mute tawa ma anpa. tan pakala ni la, ma tomo poka li ken ala esun e moku, sama ma tomo poka pi nena Kanlajon. kin la, jan mute a li lon poka ni kin. ni la, jan mute li tawa weka tan nena ni."/>
                <para/>
                <ITEXT CH="tenpo ni la, nena tu ni li awen pakala. ni la, lawa li awen lukin li awen kama sona li awen sin e ijo pakala. ni li ale a. sona pona!"/>
                <para/>
                <ITEXT CH="¹ Taal Volcano, ² Mt. Pinatubo, ³ Mayon Volcano, ⁴ Mt. Kanlaon, ⁵ Pacific Ocean, ⁶ Angeles City, ⁷ Cavite Province, ⁸ Batangas Province, ⁹ Negros Island, ¹⁰ Legazpi City"/>
                <para PARENT="toki lili poka"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="589.606299212598" YPOS="4671.49604094488" OwnPage="14" ItemID="277369232" PTYPE="4" WIDTH="129.256886885672" HEIGHT="25.5118" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" ANNAME="Kopie von Copy of lawa_1 (2)" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="14.1732283464567" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L129.257 0 L129.257 25.5118 L0 25.5118 L0 0 Z" copath="M0 0 L129.257 0 L129.257 25.5118 L0 25.5118 L0 0 Z" gXpos="589.606299212598" gYpos="4671.49604094488" gWidth="129.256886885672" gHeight="25.5118" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
